{
  "name": "microinteractions",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run check:tailwind && astro build",
    "check:tailwind": "node scripts/check-tailwind.mjs",
    "test:e2e": "playwright test",
    "test:consumer": "node scripts/check-consumer.mjs",
    "preview": "pnpm run build && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "generate:social": "node scripts/generate-social-image.mjs",
    "og:videos": "astro build && node scripts/record-og-videos.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.7",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "esbuild": "^0.28.2",
    "wrangler": "^4.158.0"
  }
}
