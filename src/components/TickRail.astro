<tick-rail class="tkr">
  <nav class="tkr-rail" aria-label="On this page" data-rail>
    <a class="tkr-tick" href="#tkr-overview" aria-describedby="tkr-overview-note" aria-current="location" data-tick>
      <span class="tkr-label">Overview</span>
      <span class="tkr-line" aria-hidden="true" data-line></span>
    </a>
    <a class="tkr-tick" href="#tkr-install" aria-describedby="tkr-install-note" data-tick>
      <span class="tkr-label">Install</span>
      <span class="tkr-line" aria-hidden="true" data-line></span>
    </a>
    <a class="tkr-tick" href="#tkr-usage" aria-describedby="tkr-usage-note" data-tick>
      <span class="tkr-label">Usage</span>
      <span class="tkr-line" aria-hidden="true" data-line></span>
    </a>
    <a class="tkr-tick" href="#tkr-theming" aria-describedby="tkr-theming-note" data-tick>
      <span class="tkr-label">Theming</span>
      <span class="tkr-line" aria-hidden="true" data-line></span>
    </a>
    <a class="tkr-tick" href="#tkr-keyboard" aria-describedby="tkr-keyboard-note" data-tick>
      <span class="tkr-label">Keyboard</span>
      <span class="tkr-line" aria-hidden="true" data-line></span>
    </a>
    <a class="tkr-tick" href="#tkr-touch" aria-describedby="tkr-touch-note" data-tick>
      <span class="tkr-label">Touch</span>
      <span class="tkr-line" aria-hidden="true" data-line></span>
    </a>
    <a class="tkr-tick" href="#tkr-motion" aria-describedby="tkr-motion-note" data-tick>
      <span class="tkr-label">Reduced motion</span>
      <span class="tkr-line" aria-hidden="true" data-line></span>
    </a>
    <a class="tkr-tick" href="#tkr-support" aria-describedby="tkr-support-note" data-tick>
      <span class="tkr-label">Browser support</span>
      <span class="tkr-line" aria-hidden="true" data-line></span>
    </a>
  </nav>

  <!-- Each tick's preview text. Screen readers get it as the link's description; the card shows it on hover and focus. -->
  <div hidden>
    <span id="tkr-overview-note">What the rail does and when to reach for it.</span>
    <span id="tkr-install-note">Copy the files, or add them with the shadcn CLI.</span>
    <span id="tkr-usage-note">One link per section, each pointing at its id.</span>
    <span id="tkr-theming-note">Recolor the ticks with three custom properties.</span>
    <span id="tkr-keyboard-note">Arrow keys move between ticks; Escape hides the preview.</span>
    <span id="tkr-touch-note">The first tap previews a section, the second goes there.</span>
    <span id="tkr-motion-note">Ticks and the card change at once, without travel or fades.</span>
    <span id="tkr-support-note">Works in every current browser, with a no-JS fallback.</span>
  </div>

  <div class="tkr-page" data-scroll>
    <section class="tkr-section" id="tkr-overview">
      <h3>Overview</h3>
      <p>A rail of short ticks, one per section. The ticks grow around the pointer, and a card previews the section under it.</p>
    </section>
    <section class="tkr-section" id="tkr-install">
      <h3>Install</h3>
      <p>Copy the markup, styles, and script, or install the React port with the shadcn CLI.</p>
    </section>
    <section class="tkr-section" id="tkr-usage">
      <h3>Usage</h3>
      <p>Give every section an id and the rail one link per section. The links work as plain anchors before the script runs.</p>
    </section>
    <section class="tkr-section" id="tkr-theming">
      <h3>Theming</h3>
      <p>Set the colors of the ticks, the lit tick, and the current section on the component or any ancestor.</p>
    </section>
    <section class="tkr-section" id="tkr-keyboard">
      <h3>Keyboard</h3>
      <p>Tab reaches each tick. Up and Down move between them, Home and End jump, and Escape hides the card.</p>
    </section>
    <section class="tkr-section" id="tkr-touch">
      <h3>Touch</h3>
      <p>A finger can't hover, so the first tap shows the card and a second tap on the same tick follows the link.</p>
    </section>
    <section class="tkr-section" id="tkr-motion">
      <h3>Reduced motion</h3>
      <p>The ticks change length at once, and the card appears, moves, and changes its text without animating.</p>
    </section>
    <section class="tkr-section" id="tkr-support">
      <h3>Browser support</h3>
      <p>Current Chrome, Edge, Firefox, and Safari. Without JavaScript, the ticks are ordinary links.</p>
    </section>
  </div>

  <div class="tkr-card" aria-hidden="true" data-card>
    <div class="tkr-card-box" data-card-box></div>
  </div>
  <template data-card-template>
    <div class="tkr-face" data-face>
      <p class="tkr-face-title" data-face-title></p>
      <p class="tkr-face-text" data-face-text></p>
    </div>
  </template>
</tick-rail>

<script>
  // Tick lengths follow the pointer's exact position, not just the row it's in.
  // A tick at the pointer is full length; the weight falls off on a cosine over RADIUS rows.
  const RADIUS = 3;
  // The card's travel and height live in the CSS; these time the text inside it.
  // The old text leaves the way the card travels; the new one comes in from behind, without waiting for it.
  const EASE = 'cubic-bezier(0.23, 1, 0.32, 1)';
  const TEXT_OUT = 120;
  const TEXT_IN = 180;
  const SHIFT = 4;
  const BLUR = 3;
  // Crossing the rail on the way somewhere else shouldn't flash a card, and leaving it for a moment shouldn't close it.
  // The open waits for the pointer to stop moving sideways: one crossing the rail keeps moving across it, while
  // one reading it moves down. Sideways means at least this many pixels between two moves.
  const OPEN_DELAY = 80;
  const SIDEWAYS = 2;
  const CLOSE_DELAY = 120;
  // A card closed this recently reopens without the delay. Within its fade-out, which matches the CSS, it turns back
  // and travels to the new tick; after that, it appears at once.
  const WARM = 400;
  const FADE_OUT = 120;
  // iOS follows a tap with mouse events at the same spot; mouse events this soon after a touch ends are those.
  const TOUCH_ECHO = 50;
  // The section that counts as current is the last one whose top has passed this fraction of the view.
  const READ_LINE = 0.3;
  // A scroll the script started counts as finished once no scroll event has come for this long.
  const SCROLL_SETTLE = 150;

  class TickRail extends HTMLElement {
    #controller: AbortController | undefined;

    connectedCallback() {
      this.#controller = new AbortController();
      const { signal } = this.#controller;
      const rail = this.querySelector<HTMLElement>('[data-rail]');
      const card = this.querySelector<HTMLElement>('[data-card]');
      const box = this.querySelector<HTMLElement>('[data-card-box]');
      const ticks = [...this.querySelectorAll<HTMLAnchorElement>('[data-tick]')];
      // A <template>, or any hidden element where a framework can't render one; its first child is the card's text.
      const template = this.querySelector<HTMLElement>('[data-card-template]');
      const faceSource = template instanceof HTMLTemplateElement ? template.content : template;
      const lines = ticks.map((tick) => tick.querySelector<HTMLElement>('[data-line]'));
      const sections = ticks.map((tick) => document.getElementById(decodeURIComponent(tick.hash.slice(1))));

      const faceTemplate = faceSource?.firstElementChild;
      if (
        !rail || !card || !box || !faceTemplate?.querySelector('[data-face-title]') || !faceTemplate.querySelector('[data-face-text]') ||
        !ticks.length || lines.includes(null) || sections.includes(null)
      ) {
        throw new Error('TickRail: needs a rail, a card with a title and text in its template, and ticks that each link to a section on the page.');
      }
      // Narrowed once the check above has run.
      const bars = lines as HTMLElement[];
      const targets = sections as HTMLElement[];
      // A scrolling container inside the component, or the page itself.
      const scroller = this.querySelector<HTMLElement>('[data-scroll]');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

      // Each tick's card text: its label and the description its link points to.
      const previews = ticks.map((tick) => ({
        title: tick.textContent!.trim(),
        text: (tick.getAttribute('aria-describedby') ?? '')
          .split(/\s+/)
          .filter(Boolean)
          .map((id) => document.getElementById(id)?.textContent?.trim() ?? '')
          .join(' '),
      }));

      // What lights a tick, in order of priority: the mouse over the rail, the mouse over the card (which keeps the
      // card's tick lit, so the card can be hovered), a tap on touch, and keyboard focus. Escape and a plain click set
      // `dismissed`, which hides the card until another tick is lit.
      let hovered: number | null = null;
      // Pointer position from the first tick's top, in the component's own pixels.
      let pointer: number | null = null;
      let overCard = false;
      let pinned: number | null = null;
      let focused: number | null = null;
      let pressedWith: string | null = null;
      let dismissed = false;
      let shown: number | null = null;
      // The tick the card showed last, and whether it closed without its fade, for a reopen soon after.
      let lastShown: number | null = null;
      let closedInstantly = false;
      let current = Math.max(0, ticks.findIndex((tick) => tick.hasAttribute('aria-current')));
      let closedAt = -Infinity;
      let openTimer = 0;
      let closeTimer = 0;
      // The pointer's last horizontal position over the rail, in screen pixels.
      let lastX: number | null = null;
      let touchEndedAt = -Infinity;
      // Set while the card hands its click to a tick: that click has no pointer type, but it came from a pointer.
      let viaCard = false;

      // Sections get focused after a click; only the ones without a tabindex get one, and lose it on disconnect.
      const tabindexAdded = targets.filter((section) => !section.hasAttribute('tabindex'));
      tabindexAdded.forEach((section) => section.setAttribute('tabindex', '-1'));

      const anchor = () => hovered ?? (overCard ? shown : null) ?? pinned ?? focused;
      const lit = () => (dismissed ? null : anchor());
      // Boxes come back scaled by any transformed or zoomed ancestor; dividing by the element's vertical scale returns
      // to its own units. The card is positioned from the padding edge, so the border comes off.
      const scaleY = () => this.getBoundingClientRect().height / this.offsetHeight || 1;
      const top = (element: Element) =>
        (element.getBoundingClientRect().top - this.getBoundingClientRect().top) / scaleY() - this.clientTop;
      // Resting lengths, as fractions of the full one: any tick, and the current one while nothing is lit.
      // Read once, so theming them takes a reconnect.
      const style = getComputedStyle(this);
      const read = (name: string, fallback: number) => {
        const value = parseFloat(style.getPropertyValue(name));
        return Number.isNaN(value) ? fallback : value;
      };
      const restScale = read('--tkr-rest', 1 / 3);
      const currentScale = read('--tkr-current', 2 / 3);

      // Ticks

      const weight = (distance: number) => {
        const t = Math.min(distance / RADIUS, 1);
        return (1 + Math.cos(Math.PI * t)) / 2;
      };

      const render = (instant: boolean) => {
        this.toggleAttribute('data-instant', instant || reduceMotion.matches);
        const size = ticks[0].offsetHeight;
        // The pointer's row center, as a fractional index; any other lit tick is its own center.
        const center = hovered !== null && pointer !== null ? pointer / size - 0.5 : anchor();
        ticks.forEach((tick, i) => {
          const falloff = center === null ? restScale : restScale + (1 - restScale) * weight(Math.abs(i - center));
          // The current tick never gets shorter than its own length, so it isn't marked by color alone.
          const scale = i === current ? Math.max(falloff, currentScale) : falloff;
          bars[i].style.transform = `scaleX(${scale})`;
          tick.toggleAttribute('data-lit', i === lit());
        });
      };

      // A rail taller than the component scrolls; the current tick stays in view, 8px from its edge.
      const reveal = (tick: HTMLElement) => {
        if (rail.scrollHeight <= rail.clientHeight) return;
        const offset = top(tick) - top(rail) - rail.clientTop;
        if (offset < 8) rail.scrollTop += offset - 8;
        else if (offset + tick.offsetHeight > rail.clientHeight - 8) rail.scrollTop += offset + tick.offsetHeight - rail.clientHeight + 8;
      };

      const setCurrent = (index: number) => {
        current = index;
        ticks.forEach((tick, i) => {
          if (i === index) tick.setAttribute('aria-current', 'location');
          else tick.removeAttribute('aria-current');
        });
        reveal(ticks[index]);
      };


      // Card

      const boxInsets = () => {
        const { paddingTop, paddingBottom, borderTopWidth, borderBottomWidth } = getComputedStyle(box);
        return [paddingTop, paddingBottom, borderTopWidth, borderBottomWidth].reduce((sum, value) => sum + parseFloat(value), 0);
      };

      // The card's text comes from the template, so each variant styles it in its own markup.
      const face = (index: number) => {
        const element = faceTemplate.cloneNode(true) as HTMLElement;
        element.querySelector('[data-face-title]')!.textContent = previews[index].title;
        element.querySelector('[data-face-text]')!.textContent = previews[index].text;
        return element;
      };

      // Swaps the card's text and returns the height the card needs for it.
      const swap = (index: number, direction: number, animate: boolean) => {
        const leaving = [...box.querySelectorAll<HTMLElement>('[data-face]:not([data-leaving])')];
        const next = face(index);
        box.append(next);
        const height = next.offsetHeight + boxInsets();
        if (!animate) {
          box.querySelectorAll('[data-face]').forEach((old) => old !== next && old.remove());
          return height;
        }
        const away = (sign: number) => ({ opacity: 0, transform: `translateY(${sign * SHIFT}px)`, filter: `blur(${BLUR}px)` });
        leaving.forEach((old) => {
          old.setAttribute('data-leaving', '');
          // A face still coming in leaves from where it is, not from full opacity.
          old.getAnimations().forEach((animation) => {
            animation.commitStyles();
            animation.cancel();
          });
          old
            .animate([away(direction)], { duration: TEXT_OUT, easing: EASE, fill: 'forwards' })
            .finished.then(() => old.remove(), () => {});
        });
        next.animate([away(-direction), { opacity: 1, transform: 'none', filter: 'blur(0px)' }], {
          duration: TEXT_IN,
          easing: EASE,
        });
        return height;
      };

      // Applies a change to the card with some of its transitions off, then turns them back on.
      // `data-jump` drops the travel and the resize but keeps the fade; `data-instant` drops everything.
      const without = (attribute: 'data-jump' | 'data-instant' | null, change: () => void) => {
        if (attribute) card.setAttribute(attribute, '');
        change();
        if (!attribute) return;
        void card.offsetWidth;
        card.removeAttribute(attribute);
      };

      // Centers the card on its tick, kept 8px inside the component. A card taller than that clips its text.
      const place = (index: number, needed: number) => {
        const tick = ticks[index];
        const height = Math.min(needed, this.clientHeight - 16);
        const middle = top(tick) + tick.offsetHeight / 2;
        const y = Math.max(Math.min(middle - height / 2, this.clientHeight - height - 8), 8);
        card.style.transform = `translateY(${Math.round(y)}px)`;
        box.style.height = `${height}px`;
      };

      // Keyboard changes and reduced motion land at once. A card the pointer opens appears on its tick and fades in;
      // from there it travels between ticks. A card still fading out counts as open: it turns back from where its fade
      // has reached and travels on. One that has just gone reappears without a fade, which would only lag the pointer.
      const show = (index: number, instant: boolean) => {
        if (index === shown) return;
        const since = performance.now() - closedAt;
        const from = shown ?? (since < FADE_OUT && !closedInstantly ? lastShown : null);
        const still = instant || reduceMotion.matches || (from === null && since < WARM);
        const direction = from === null || index > from ? 1 : -1;
        const height = swap(index, direction, from !== null && from !== index && !still);
        without(still ? 'data-instant' : from === null ? 'data-jump' : null, () => {
          place(index, height);
          card.setAttribute('data-showing', '');
        });
        shown = index;
      };

      const hide = (instant: boolean) => {
        if (shown === null) return;
        lastShown = shown;
        shown = null;
        overCard = false;
        closedAt = performance.now();
        closedInstantly = instant || reduceMotion.matches;
        without(closedInstantly ? 'data-instant' : null, () => card.removeAttribute('data-showing'));
      };

      // A pending open reads the latest tick when it fires.
      const arm = () => {
        clearTimeout(openTimer);
        openTimer = window.setTimeout(() => {
          openTimer = 0;
          const latest = lit();
          if (latest !== null) show(latest, false);
        }, OPEN_DELAY);
      };

      // Keyboard changes are instant: the card opens and closes without delays and moves without travel.
      const update = (instant: boolean) => {
        render(instant);
        const next = lit();
        clearTimeout(closeTimer);
        if (next === null) {
          clearTimeout(openTimer);
          openTimer = 0;
          if (shown !== null) {
            if (instant) hide(true);
            else closeTimer = window.setTimeout(() => hide(false), CLOSE_DELAY);
          }
          return;
        }
        if (shown !== null) return show(next, instant);
        // Moving down the rail doesn't restart a pending open; only moving across it does, in the pointer handler.
        if (openTimer) return;
        const warm = performance.now() - closedAt < WARM;
        if (instant || warm || pinned !== null) return show(next, instant);
        arm();
      };

      const dismiss = () => {
        dismissed = true;
        pinned = null;
        update(true);
      };

      // Pointer

      rail.addEventListener(
        'pointermove',
        (event) => {
          if (event.pointerType !== 'mouse' || performance.now() - touchEndedAt < TOUCH_ECHO) return;
          // From clientX, since WebKit can report movementX as 0.
          const sideways = lastX !== null && Math.abs(event.clientX - lastX) >= SIDEWAYS;
          lastX = event.clientX;
          if (sideways && openTimer) arm();
          const y = (event.clientY - ticks[0].getBoundingClientRect().top) / scaleY();
          // Rows are laid out back to back at one height, so the pointer's row is its distance from the first tick in rows.
          const row = Math.floor(y / ticks[0].offsetHeight);
          const next = row >= 0 && row < ticks.length ? row : null;
          pointer = next === null ? null : y;
          if (next === hovered) return render(false);
          hovered = next;
          dismissed = false;
          update(false);
        },
        { signal },
      );

      rail.addEventListener(
        'pointerleave',
        (event) => {
          if (event.pointerType !== 'mouse') return;
          hovered = null;
          pointer = null;
          lastX = null;
          update(false);
        },
        { signal },
      );

      // The card can be hovered: moving onto it keeps it open (WCAG 1.4.13), and leaving it closes it like the rail.
      card.addEventListener(
        'pointerenter',
        (event) => {
          if (event.pointerType !== 'mouse' || shown === null || performance.now() - touchEndedAt < TOUCH_ECHO) return;
          overCard = true;
          update(false);
        },
        { signal },
      );

      card.addEventListener(
        'pointerleave',
        (event) => {
          if (event.pointerType !== 'mouse' || !overCard) return;
          overCard = false;
          update(false);
        },
        { signal },
      );

      // The card is a bigger target than its 24px row: a click or tap on it goes to its section, like the tick.
      card.addEventListener(
        'click',
        () => {
          if (shown === null) return;
          viaCard = true;
          ticks[shown].click();
          viaCard = false;
        },
        { signal },
      );

      // The card sits beside the scrolling area, not in it, so the wheel over it scrolls that area by hand.
      card.addEventListener(
        'wheel',
        (event) => {
          if (!scroller) return;
          event.preventDefault();
          const unit = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16 : event.deltaMode === WheelEvent.DOM_DELTA_PAGE ? scroller.clientHeight : 1;
          scroller.scrollBy({ top: event.deltaY * unit });
        },
        { passive: false, signal },
      );

      // Focus: only keyboard focus opens the card. A click that focuses a link is already showing it.
      rail.addEventListener(
        'focusin',
        (event) => {
          const index = ticks.indexOf(event.target as HTMLAnchorElement);
          if (index < 0 || !(event.target as HTMLElement).matches(':focus-visible')) return;
          focused = index;
          dismissed = false;
          update(true);
        },
        { signal },
      );

      rail.addEventListener(
        'focusout',
        (event) => {
          if (rail.contains(event.relatedTarget as Node | null)) return;
          focused = null;
          pinned = null;
          update(true);
        },
        { signal },
      );

      // Up and Down move focus between ticks, stopping at the ends; Home and End jump.
      rail.addEventListener(
        'keydown',
        (event) => {
          const index = ticks.indexOf(event.target as HTMLAnchorElement);
          if (index < 0) return;
          // The key press is the witness for a click that follows it: Enter on a link clicks it, and not every browser
          // gives that click an empty pointer type. It also keeps a press that never became a click from making it look
          // like a tap.
          pressedWith = '';
          let next: number | undefined;
          if (event.key === 'ArrowDown') next = Math.min(index + 1, ticks.length - 1);
          else if (event.key === 'ArrowUp') next = Math.max(index - 1, 0);
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = ticks.length - 1;
          if (next === undefined) return;
          event.preventDefault();
          ticks[next].focus();
        },
        { signal },
      );

      // Escape hides the card wherever focus is, since a card opened by hover covers the content (WCAG 1.4.13).
      // It only claims the key from the rail, so a dialog or menu elsewhere still gets its own Escape.
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'Escape' || event.defaultPrevented || shown === null) return;
          if (rail.contains(event.target as Node)) event.preventDefault();
          dismiss();
        },
        { signal },
      );

      // A section chosen from the rail stays current until the reader scrolls on their own. Near the end, the scroll
      // can't bring it to the read line, and the last section would take over.
      let locked = false;
      let settling = false;
      let settleTimer = 0;
      const settle = () => {
        clearTimeout(settleTimer);
        settleTimer = window.setTimeout(() => (settling = false), SCROLL_SETTLE);
      };

      ticks.forEach((tick, i) => {
        tick.addEventListener('pointerdown', (event) => (pressedWith = event.pointerType), { signal });
        tick.addEventListener('pointercancel', () => (pressedWith = null), { signal });
        tick.addEventListener(
          'click',
          (event) => {
            const pressed = pressedWith;
            pressedWith = null;
            // Opening in a new tab or window stays the browser's.
            if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            // Current browsers send clicks as pointer events, with an empty type for the keyboard and assistive tech.
            // Past that, the pointerdown before the click is the better witness: WebKit reports a tap's click as a mouse.
            const clickType = 'pointerType' in event ? (event as PointerEvent).pointerType : undefined;
            const type = clickType === '' ? '' : (pressed ?? clickType);
            if (type && type !== 'mouse' && pinned !== i) {
              event.preventDefault();
              pinned = i;
              dismissed = false;
              update(false);
              return;
            }
            // The click took the reader to the section, so the card closes like on Escape rather than covering it.
            // It comes back, warm, on the next tick the pointer moves to.
            pinned = null;
            dismissed = true;
            setCurrent(i);
            update(true);
            locked = true;
            settling = true;
            settle();
            // On the page, the link scrolls as an anchor. Inside a scrolling container, the script scrolls it,
            // so the window and the URL stay put.
            if (!scroller) return;
            event.preventDefault();
            // The distance comes back in screen pixels; the scroller's own scale turns it into its scroll units.
            const view = scroller.getBoundingClientRect();
            const y = (targets[i].getBoundingClientRect().top - view.top) / (view.height / scroller.offsetHeight || 1);
            // The keyboard and assistive technology click without a pointer type, and their moves land at once.
            const keyed = !type && !viaCard;
            scroller.scrollTo({ top: scroller.scrollTop + y - scroller.clientTop, behavior: reduceMotion.matches || keyed ? 'auto' : 'smooth' });
            targets[i].focus({ preventScroll: true });
          },
          { signal },
        );
      });

      // The next press outside the rail and the card stands in for the pointer leaving it. A mouse closes the card on
      // the press. Touch waits for the release, with no pointercancel in between: a scroll that starts outside cancels
      // the pointer, so it keeps a card pinned. A tap also clears any hover that iOS's mouse echo got past the guard.
      const outside = (target: EventTarget | null) => !rail.contains(target as Node) && !card.contains(target as Node);
      let tapOutside = false;
      document.addEventListener(
        'pointerdown',
        (event) => {
          if (event.pointerType !== 'mouse') {
            tapOutside = outside(event.target);
            return;
          }
          if (pinned === null || !outside(event.target)) return;
          pinned = null;
          update(false);
        },
        { capture: true, signal },
      );
      document.addEventListener('pointercancel', () => (tapOutside = false), { capture: true, signal });
      document.addEventListener(
        'pointerup',
        (event) => {
          if (event.pointerType === 'mouse') return;
          touchEndedAt = performance.now();
          if (!tapOutside || !outside(event.target)) return;
          tapOutside = false;
          pinned = hovered = pointer = lastX = null;
          overCard = false;
          update(false);
        },
        { capture: true, signal },
      );

      // Current section

      let frame = 0;
      const track = () => {
        frame = 0;
        if (locked) return;
        const view = scroller ? scroller.getBoundingClientRect() : { top: 0, bottom: innerHeight };
        const line = view.top + (view.bottom - view.top) * READ_LINE;
        let next = 0;
        targets.forEach((section, i) => {
          if (section.getBoundingClientRect().top <= line) next = i;
        });
        const end = scroller
          ? scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 1
          : scrollY + innerHeight >= document.documentElement.scrollHeight - 1;
        if (end) next = targets.length - 1;
        if (next === current) return;
        setCurrent(next);
        render(false);
      };
      const schedule = () => (frame ||= requestAnimationFrame(track));
      const onScroll = () => {
        if (settling) return settle();
        locked = false;
        schedule();
      };
      (scroller ?? window).addEventListener('scroll', onScroll, { passive: true, signal });
      window.addEventListener('resize', schedule, { signal });

      // Turning reduced motion on mid-move lands the move at once.
      reduceMotion.addEventListener(
        'change',
        () => reduceMotion.matches && this.getAnimations({ subtree: true }).forEach((animation) => animation.finish()),
        { signal },
      );

      signal.addEventListener('abort', () => {
        clearTimeout(openTimer);
        clearTimeout(closeTimer);
        clearTimeout(settleTimer);
        cancelAnimationFrame(frame);
        hovered = pointer = focused = pinned = shown = lastShown = lastX = null;
        overCard = false;
        card.removeAttribute('data-showing');
        box.querySelectorAll('[data-face]').forEach((old) => old.remove());
        tabindexAdded.forEach((section) => section.removeAttribute('tabindex'));
      });

      // The markup may mark no tick, or more than one; start from exactly one.
      setCurrent(current);
      track();
      render(true);
    }

    disconnectedCallback() {
      this.#controller?.abort();
    }
  }

  // A script in <head> would otherwise upgrade the element before its children are parsed.
  // The guard lets the script run twice on one page without throwing.
  const define = () => {
    if (!customElements.get('tick-rail')) customElements.define('tick-rail', TickRail);
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', define);
  else define();
</script>

<style>
  .tkr {
