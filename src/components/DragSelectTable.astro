<drag-select-table class="dst">
  <div class="dst-head">
    <p class="dst-title">Planned studies</p>
    <p class="dst-count" data-count>0 of 10</p>
  </div>
  <div class="dst-scroll" data-scroll>
    <table class="dst-table" aria-label="Planned studies">
      <thead>
        <tr>
          <th class="dst-box-cell" scope="col">
            <span class="dst-box">
              <input type="checkbox" aria-label="Select all" data-all />
              <svg class="dst-check" viewBox="0 0 18 18" aria-hidden="true">
                <path pathLength="1" d="M5 9.4l2.7 2.6L13 6.5"></path>
              </svg>
              <svg class="dst-dash" viewBox="0 0 18 18" aria-hidden="true">
                <path d="M5.5 9h7"></path>
              </svg>
            </span>
          </th>
          <th scope="col">Study</th>
          <th scope="col">Category</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="dst-box-cell" data-box-cell>
            <span class="dst-box">
              <input type="checkbox" aria-label="Copy to clipboard" />
              <svg class="dst-check" viewBox="0 0 18 18" aria-hidden="true">
                <path pathLength="1" d="M5 9.4l2.7 2.6L13 6.5"></path>
              </svg>
            </span>
          </td>
          <th scope="row">Copy to clipboard</th>
          <td class="dst-category">Actions</td>
        </tr>
        <tr>
          <td class="dst-box-cell" data-box-cell>
            <span class="dst-box">
              <input type="checkbox" aria-label="Tab indicator" />
              <svg class="dst-check" viewBox="0 0 18 18" aria-hidden="true">
                <path pathLength="1" d="M5 9.4l2.7 2.6L13 6.5"></path>
              </svg>
            </span>
          </td>
          <th scope="row">Tab indicator</th>
          <td class="dst-category">Navigation</td>
        </tr>
        <tr>
          <td class="dst-box-cell" data-box-cell>
            <span class="dst-box">
              <input type="checkbox" aria-label="Switch" />
              <svg class="dst-check" viewBox="0 0 18 18" aria-hidden="true">
                <path pathLength="1" d="M5 9.4l2.7 2.6L13 6.5"></path>
              </svg>
            </span>
          </td>
          <th scope="row">Switch</th>
          <td class="dst-category">Toggles &amp; choices</td>
        </tr>
        <tr>
          <td class="dst-box-cell" data-box-cell>
            <span class="dst-box">
              <input type="checkbox" aria-label="Segmented control" />
              <svg class="dst-check" viewBox="0 0 18 18" aria-hidden="true">
                <path pathLength="1" d="M5 9.4l2.7 2.6L13 6.5"></path>
              </svg>
            </span>
          </td>
          <th scope="row">Segmented control</th>
          <td class="dst-category">Toggles &amp; choices</td>
        </tr>
        <tr>
          <td class="dst-box-cell" data-box-cell>
            <span class="dst-box">
              <input type="checkbox" aria-label="Number scrub" />
              <svg class="dst-check" viewBox="0 0 18 18" aria-hidden="true">
                <path pathLength="1" d="M5 9.4l2.7 2.6L13 6.5"></path>
              </svg>
            </span>
          </td>
          <th scope="row">Number scrub</th>
          <td class="dst-category">Values</td>
        </tr>
        <tr>
          <td class="dst-box-cell" data-box-cell>
            <span class="dst-box">
              <input type="checkbox" aria-label="One-time code" />
              <svg class="dst-check" viewBox="0 0 18 18" aria-hidden="true">
                <path pathLength="1" d="M5 9.4l2.7 2.6L13 6.5"></path>
              </svg>
            </span>
          </td>
          <th scope="row">One-time code</th>
          <td class="dst-category">Input</td>
        </tr>
        <tr>
          <td class="dst-box-cell" data-box-cell>
            <span class="dst-box">
              <input type="checkbox" aria-label="Popover" />
              <svg class="dst-check" viewBox="0 0 18 18" aria-hidden="true">
                <path pathLength="1" d="M5 9.4l2.7 2.6L13 6.5"></path>
              </svg>
            </span>
          </td>
          <th scope="row">Popover</th>
          <td class="dst-category">Disclosure</td>
        </tr>
        <tr>
          <td class="dst-box-cell" data-box-cell>
            <span class="dst-box">
              <input type="checkbox" aria-label="Toast" />
              <svg class="dst-check" viewBox="0 0 18 18" aria-hidden="true">
                <path pathLength="1" d="M5 9.4l2.7 2.6L13 6.5"></path>
              </svg>
            </span>
          </td>
          <th scope="row">Toast</th>
          <td class="dst-category">Feedback</td>
        </tr>
        <tr>
          <td class="dst-box-cell" data-box-cell>
            <span class="dst-box">
              <input type="checkbox" aria-label="Undo" />
              <svg class="dst-check" viewBox="0 0 18 18" aria-hidden="true">
                <path pathLength="1" d="M5 9.4l2.7 2.6L13 6.5"></path>
              </svg>
            </span>
          </td>
          <th scope="row">Undo</th>
          <td class="dst-category">Feedback</td>
        </tr>
        <tr>
          <td class="dst-box-cell" data-box-cell>
            <span class="dst-box">
              <input type="checkbox" aria-label="Drag to reorder" />
              <svg class="dst-check" viewBox="0 0 18 18" aria-hidden="true">
                <path pathLength="1" d="M5 9.4l2.7 2.6L13 6.5"></path>
              </svg>
            </span>
          </td>
          <th scope="row">Drag to reorder</th>
          <td class="dst-category">Direct manipulation</td>
        </tr>
      </tbody>
    </table>
    <span class="dst-band" data-band aria-hidden="true">
      <span class="dst-band-cap" data-band-top></span>
      <span class="dst-band-body" data-band-body></span>
      <span class="dst-band-cap dst-band-cap-end" data-band-bottom></span>
    </span>
  </div>
  <p class="dst-keys" aria-hidden="true">
    <span><kbd>Shift</kbd> click or <kbd>Shift</kbd> <kbd>↑</kbd><kbd>↓</kbd> to extend</span>
    <span><kbd>Esc</kbd> to cancel</span>
  </p>
  <span class="dst-hidden" data-instructions>
    Each box toggles its row, and so does a click anywhere on the row. Drag down the box column to give a run of
    rows the first row's new state, or Shift+click to extend from the last row you changed. With focus on a box,
    Shift+Up and Shift+Down give that box's state to the rows you move onto, and moving back restores them. Escape
    cancels a drag.
  </span>
  <span class="dst-hidden" role="status"></span>
</drag-select-table>

<script>
  // Near the top or bottom edge, the list scrolls up to this many pixels per 60Hz frame.
  const EDGE = 48;
  const MAX_SCROLL = 14;
  const FRAME = 1000 / 60;
  const BAND_WIDTH = 28;
  const BAND_INSET = 6;

  let tableId = 0;

  // Rows from `anchor` to `last` take `mode`; every other row keeps its state from `snapshot`.
  // The drag and Shift+arrow runs both select this way.
  type Range = {
    anchor: number;
    last: number;
    mode: boolean;
    snapshot: boolean[];
  };

  type Drag = {
    id: number;
    range: Range;
    y: number;
    frame: number;
    time: number;
    shown: boolean;
  };

  class DragSelectTable extends HTMLElement {
    #controller: AbortController | undefined;

    connectedCallback() {
      this.#controller = new AbortController();
      const { signal } = this.#controller;
      const scroller = this.querySelector<HTMLElement>('[data-scroll]');
      const head = this.querySelector('thead');
      const all = this.querySelector<HTMLInputElement>('[data-all]');
      const count = this.querySelector<HTMLElement>('[data-count]');
      const status = this.querySelector<HTMLElement>('[role="status"]');
      const instructions = this.querySelector<HTMLElement>('[data-instructions]');
      const tableElement = this.querySelector('table');
      const band = this.querySelector<HTMLElement>('[data-band]');
      const bandTop = this.querySelector<HTMLElement>('[data-band-top]');
      const bandBody = this.querySelector<HTMLElement>('[data-band-body]');
      const bandBottom = this.querySelector<HTMLElement>('[data-band-bottom]');

      if (
        !scroller || !head || !all || !count || !status || !instructions || !tableElement ||
        !band || !bandTop || !bandBody || !bandBottom
      ) {
        throw new Error('DragSelectTable: missing required elements.');
      }

      instructions.id = `drag-select-instructions-${++tableId}`;
      tableElement.setAttribute('aria-describedby', instructions.id);

      const rows = [...this.querySelectorAll<HTMLTableRowElement>('tbody tr')];
      const boxes = rows.map((row) => row.querySelector('input') as HTMLInputElement);
      const total = rows.length;

      let drag: Drag | null = null;
      // A Shift+arrow run continues while each press starts where the previous one left focus.
      let keyRange: Range | null = null;
      // The last box the user changed; Shift+click extends from here.
      let anchor = -1;
      // The native click after a handled press would toggle the box a second time.
      let suppressClick = false;
      // True while `commit()` dispatches, so the component's own `change` events don't re-enter it.
      let committing = false;
      let announceTimer: ReturnType<typeof setTimeout> | undefined;
      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      const states = () => boxes.map((box) => box.checked);

      // Setting `checked` from script fires no events. `input` reports each step as it happens…
      const set = (index: number, checked: boolean) => {
        const box = boxes[index];
        if (box.checked === checked) return;
        box.checked = checked;
        box.dispatchEvent(new Event('input', { bubbles: true }));
      };

      // …and `change` reports what an interaction left behind, once, for the boxes that differ.
      const commit = (before: boolean[]) => {
        committing = true;
        boxes.forEach((box, index) => {
          if (box.checked !== before[index]) box.dispatchEvent(new Event('change', { bubbles: true }));
        });
        committing = false;
        announce();
      };

      // Everything the selection looks like is derived from the boxes, here and nowhere else.
      // Selected neighbours read as one block, so only a group's outer corners are rounded.
      const sync = () => {
        let selected = 0;
        rows.forEach((row, index) => {
          const on = boxes[index].checked;
          if (on) selected++;
          const up = index > 0 && boxes[index - 1].checked;
          const down = index < total - 1 && boxes[index + 1].checked;
          row.toggleAttribute('data-selected', on);
          row.dataset.edge = on ? [up ? '' : 'top', down ? '' : 'bottom'].join(' ').trim() : '';
        });
        all.checked = total > 0 && selected === total;
        all.indeterminate = selected > 0 && selected < total;
        all.disabled = total === 0;
        count.textContent = `${selected} of ${total}`;
      };

      // Screen readers hear the settled count once, not every row a drag crosses.
      const announce = () => {
        clearTimeout(announceTimer);
        announceTimer = setTimeout(() => {
          const selected = boxes.filter((box) => box.checked).length;
          status.textContent = selected ? `${selected} selected` : 'None selected';
        }, 250);
      };

      const applyRange = (range: Range, current: number) => {
        range.last = current;
        const lo = Math.min(range.anchor, current);
        const hi = Math.max(range.anchor, current);
        boxes.forEach((_, index) => set(index, index >= lo && index <= hi ? range.mode : range.snapshot[index]));
        sync();
      };

      // Clamped, so dragging past either end still reaches the first or last row.
      const rowAt = (y: number) => {
        for (let index = 0; index < total; index++) {
          if (y < rows[index].getBoundingClientRect().bottom) return index;
        }
        return total - 1;
      };

      // The band lives inside the scroller, so it scrolls with the rows it measures. It moves
      // with transforms only: two fixed caps travel, and the body between them scales.
      const placeBand = () => {
        if (!drag) return;
        const lo = Math.min(drag.range.anchor, drag.range.last);
        const hi = Math.max(drag.range.anchor, drag.range.last);
        const frame = scroller.getBoundingClientRect();
        const first = rows[lo].getBoundingClientRect();
        const last = rows[hi].getBoundingClientRect();
        const cell = rows[lo].cells[0].getBoundingClientRect();
        const cap = BAND_WIDTH / 2;
        const top = first.top - frame.top + scroller.scrollTop + BAND_INSET;
        const height = last.bottom - first.top - BAND_INSET * 2;
        band.style.transform = `translateX(${cell.left - frame.left + (cell.width - BAND_WIDTH) / 2}px)`;
        bandTop.style.transform = `translateY(${top}px)`;
        bandBody.style.transform = `translateY(${top + cap}px) scaleY(${Math.max(0, height - cap * 2)})`;
        bandBottom.style.transform = `translateY(${top + height - cap}px)`;
      };

      // The band waits for a second row, so a plain click doesn't flash it. Its first placement
      // skips the transition, so it appears in place instead of sliding in from the last drag.
      const paint = (current: number) => {
        if (!drag || current === drag.range.last) return;
        applyRange(drag.range, current);
        if (drag.shown) {
          placeBand();
          return;
        }
        if (current === drag.range.anchor) return;
        drag.shown = true;
        band.dataset.instant = '';
        placeBand();
        void band.offsetWidth;
        delete band.dataset.instant;
        band.dataset.shown = '';
      };

      // Scaled by elapsed time, so a 120Hz display scrolls no faster than a 60Hz one.
      const autoscroll = (now: number) => {
        if (!drag) return;
        const elapsed = drag.time ? Math.min(32, now - drag.time) : FRAME;
        drag.time = now;
        const frame = scroller.getBoundingClientRect();
        const top = frame.top + head.offsetHeight;
        let depth = 0;
        if (drag.y < top + EDGE) depth = -Math.min(1, (top + EDGE - drag.y) / EDGE);
        else if (drag.y > frame.bottom - EDGE) depth = Math.min(1, (drag.y - (frame.bottom - EDGE)) / EDGE);
        // Squared, so the speed ramps up gently near the edge.
        if (depth) {
          scroller.scrollTop += Math.sign(depth) * Math.max(1, ((depth * depth * MAX_SCROLL) * elapsed) / FRAME);
        }
        drag.frame = requestAnimationFrame(autoscroll);
      };

      const focusBox = (index: number) => {
        boxes[index].dataset.pointerFocus = '';
        boxes[index].focus({ preventScroll: true });
      };

      const begin = (index: number, id: number, y: number) => {
        suppressClick = true;
        anchor = index;
        const mode = !boxes[index].checked;
        drag = {
          id,
          range: { anchor: index, last: index, mode, snapshot: states() },
          y,
          frame: 0,
          time: 0,
          shown: false,
        };
        set(index, mode);
        sync();
        this.dataset.dragging = '';
        band.dataset.mode = mode ? 'check' : 'clear';
        focusBox(index);
        scroller.setPointerCapture(id);
        drag.frame = requestAnimationFrame(autoscroll);
      };

      // A finished drag reports its changes once. A cancelled one puts every box back.
      const end = (keep: boolean) => {
        if (!drag) return;
        const { frame, id, range } = drag;
        drag = null;
        cancelAnimationFrame(frame);
        if (!keep) range.snapshot.forEach((checked, index) => set(index, checked));
        if (scroller.hasPointerCapture(id)) scroller.releasePointerCapture(id);
        delete this.dataset.dragging;
        delete band.dataset.shown;
        sync();
        if (keep) commit(range.snapshot);
        else announce();
      };

      // Shift+click sets every row from the anchor to the clicked row to the clicked row's new state.
      const extend = (index: number) => {
        const before = states();
        const mode = !boxes[index].checked;
        if (anchor < 0) anchor = index;
        for (let i = Math.min(anchor, index); i <= Math.max(anchor, index); i++) set(i, mode);
        sync();
        commit(before);
        focusBox(index);
      };

      const toggle = (index: number) => {
        const before = states();
        set(index, !boxes[index].checked);
        anchor = index;
        sync();
        commit(before);
        focusBox(index);
      };

      scroller.addEventListener(
        'pointerdown',
        (event) => {
          suppressClick = false;
          if (drag || event.button !== 0 || !event.isPrimary) return;
          // Ctrl-click opens the context menu on macOS; modified clicks keep the native toggle.
          if (event.ctrlKey || event.metaKey || event.altKey) return;
          const cell = (event.target as Element).closest('td, th');
          const index = rows.indexOf(cell?.parentElement as HTMLTableRowElement);
          if (!cell || index < 0) return;
          keyRange = null;
          if (!cell.hasAttribute('data-box-cell')) {
            // Shift+click on a row extends the selection; keep the press from selecting text instead.
            if (event.shiftKey && event.pointerType === 'mouse') event.preventDefault();
            return;
          }
          // A mouse press would start a text selection, and WebKit would blur instead of focusing.
          if (event.pointerType === 'mouse') event.preventDefault();
          if (event.shiftKey) {
            suppressClick = true;
            extend(index);
            return;
          }
          begin(index, event.pointerId, event.clientY);
        },
        { signal },
      );

      scroller.addEventListener(
        'pointermove',
        (event) => {
          if (!drag || event.pointerId !== drag.id) return;
          drag.y = event.clientY;
          paint(rowAt(event.clientY));
        },
        { signal },
      );

      // Rows move under a still pointer while the list scrolls, by autoscroll or a wheel.
      scroller.addEventListener(
        'scroll',
        () => {
          if (drag) paint(rowAt(drag.y));
        },
        { signal },
      );

      // The browser took the gesture over, so nothing the drag set was confirmed.
      scroller.addEventListener(
        'pointercancel',
        (event) => {
          if (drag?.id === event.pointerId) end(false);
        },
        { signal },
      );

      // Only a release confirms the drag.
      scroller.addEventListener(
        'pointerup',
        (event) => {
          if (drag?.id === event.pointerId) end(true);
        },
        { signal },
      );

      // Capture lost without a release, taken by other code or dropped by the browser, cancels too.
      scroller.addEventListener(
        'lostpointercapture',
        (event) => {
          if (drag?.id === event.pointerId) end(false);
        },
        { signal },
      );

      scroller.addEventListener(
        'contextmenu',
        (event) => {
          if (drag) event.preventDefault();
        },
        { signal },
      );

      this.addEventListener(
        'click',
        (event) => {
          if (!suppressClick || event.detail === 0) return;
          suppressClick = false;
          event.preventDefault();
        },
        { capture: true, signal },
      );

      document.addEventListener(
        'keydown',
        (event) => {
          if (drag && event.key === 'Escape') {
            event.preventDefault();
            end(false);
          }
        },
        { signal },
      );
      window.addEventListener('blur', () => end(false), { signal });
      // Firefox can restore checked boxes from its page cache; the rows follow them.
      window.addEventListener('pageshow', sync, { signal });

      // Space toggles natively. Arrows move between boxes; Shift+arrows select a range from the
      // box where the run started, so backing up shrinks it, like the drag.
      this.addEventListener(
        'keydown',
        (event) => {
          const target = event.target as HTMLInputElement;
          delete target.dataset.pointerFocus;
          const index = boxes.indexOf(target);
          if (index < 0 || (event.key !== 'ArrowDown' && event.key !== 'ArrowUp')) return;
          event.preventDefault();
          const next = index + (event.key === 'ArrowDown' ? 1 : -1);
          if (next < 0 || next >= total) return;
          if (event.shiftKey) {
            if (keyRange?.last !== index) {
              keyRange = { anchor: index, last: index, mode: boxes[index].checked, snapshot: states() };
            }
            const before = states();
            applyRange(keyRange, next);
            anchor = keyRange.anchor;
            commit(before);
          } else {
            keyRange = null;
          }
          boxes[next].focus();
        },
        { signal },
      );

      this.addEventListener(
        'focusout',
        (event) => delete (event.target as HTMLElement).dataset.pointerFocus,
        { signal },
      );

      // Changes from the user or from other code that sets `checked` and dispatches `change`.
      this.addEventListener(
        'change',
        (event) => {
          if (committing) return;
          keyRange = null;
          const target = event.target as HTMLInputElement;
          if (target === all) {
            const before = states();
            boxes.forEach((_, index) => set(index, all.checked));
            sync();
            commit(before);
            return;
          }
          const index = boxes.indexOf(target);
          if (index < 0) return;
          anchor = index;
          sync();
          announce();
        },
        { signal },
      );

      // The row is the checkbox's label: a click anywhere on it toggles the box, and Shift+click
      // extends. Drags still start only in the box column, so touch scrolling works on the rest.
      this.addEventListener(
        'click',
        (event) => {
          if (event.defaultPrevented || event.detail === 0) return;
          if (event.ctrlKey || event.metaKey || event.altKey) return;
          const cell = (event.target as Element).closest('td, th');
          const index = rows.indexOf(cell?.parentElement as HTMLTableRowElement);
          if (!cell || index < 0 || cell.hasAttribute('data-box-cell')) return;
          if (event.shiftKey) extend(index);
          // A click that ends a text selection is not a toggle.
          else if (document.getSelection()?.isCollapsed) toggle(index);
        },
        { signal },
      );

      // A form reset restores each box's default without a change event, once the reset event is over.
      this.closest('form')?.addEventListener(
        'reset',
        () => {
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            keyRange = null;
            anchor = -1;
            sync();
            announce();
          });
        },
        { signal },
      );

      signal.addEventListener('abort', () => {
        end(false);
        clearTimeout(announceTimer);
        clearTimeout(resetTimer);
      });

      sync();
    }

    disconnectedCallback() {
      this.#controller?.abort();
    }
  }

  // A script in <head> would otherwise upgrade the element before its children are parsed.
  // The guard lets the script run twice on one page without throwing.
  const define = () => {
    if (!customElements.get('drag-select-table')) customElements.define('drag-select-table', DragSelectTable);
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', define);
  else define();
</script>

<style>
  .dst {
    --dst-ease: cubic-bezier(0.23, 1, 0.32, 1);
    --dst-row: 40px;
    --dst-head: 36px;
    --dst-draw: 0ms;
    --dst-follow: 0ms;

    display: block;
    width: min(100%, 480px);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg);
  }

  @media (pointer: coarse) {
    .dst {
      --dst-row: 44px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .dst {
      --dst-draw: 160ms;
      --dst-follow: 90ms;
    }
  }

  .dst-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .dst-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px 10px;
  }

  .dst-title {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
  }

  .dst-count {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .dst-scroll {
    position: relative;
    max-height: calc(var(--dst-head) + var(--dst-row) * 5.5);
    padding: 0 8px 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
    /* The band and the sticky header stack against each other here, not against the page. */
    isolation: isolate;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }

  .dst-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 14px;
  }

  .dst-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    height: var(--dst-head);
    padding-block: 0;
