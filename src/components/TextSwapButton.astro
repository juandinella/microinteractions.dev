<button class="swap" type="button" aria-label="Download for macOS, 42 MB">
  <span class="swap-labels" aria-hidden="true">
    <span class="swap-layer swap-current">Download</span>
    <span class="swap-layer swap-next" data-trace-progress>macOS · 42 MB</span>
  </span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('.swap').forEach((button) => {
    // WebKit reports a tap's click as pointerType "mouse", so the device comes from pointerdown.
    let pointerType = 'mouse';
    button.addEventListener('pointerdown', (event) => {
      pointerType = event.pointerType;
    });
    button.addEventListener('click', (event) => {
      // detail is 0 for Enter, Space and key repeat, which focus already reveals.
      if (event.detail > 0 && pointerType !== 'mouse') {
        button.setAttribute('data-touch-active', '');
      }
    });
    button.addEventListener('blur', () =>
      button.removeAttribute('data-touch-active'),
    );
    // A click, unlike pointerdown, doesn't fire when a touch starts a scroll.
    document.addEventListener('click', (event) => {
      if (!button.contains(event.target as Node))
        button.removeAttribute('data-touch-active');
    });
  });
</script>

<style>
  .swap {
    --swap-bg: var(--text);
    --swap-fg: var(--bg);
    --swap-ring: var(--focus-ring, var(--swap-bg));
    --swap-ease: cubic-bezier(0.23, 1, 0.32, 1);
    --swap-state: 0;

    touch-action: manipulation;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border: 1px solid transparent;
    border-radius: 12px;
    background: var(--swap-bg);
    color: var(--swap-fg);
    cursor: pointer;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    overflow: hidden;
    transition: transform 160ms var(--ease-smooth);
  }

  .swap[data-inspect],
  .swap[data-touch-active] {
    --swap-state: 1;
  }

  .swap:focus-visible {
    --swap-state: 1;
    outline: 2px solid var(--swap-ring);
    outline-offset: 4px;
  }

  .swap-labels {
    display: inline-grid;
  }

  /* A label wider than the room left wraps, balanced, and the button grows taller instead of clipping it. */
  .swap-layer {
    grid-area: 1 / 1;
    text-align: center;
    text-wrap: balance;
    transition-property: opacity, transform, filter;
    /* 220ms toward the next label, 160ms back. */
    transition-duration: calc(160ms + var(--swap-state) * 60ms);
    transition-timing-function: var(--swap-ease);
  }

  .swap-current {
    opacity: calc(1 - var(--swap-state));
    filter: blur(calc(var(--swap-state) * 5px));
    transform: translateY(calc(var(--swap-state) * 120%));
  }

  .swap-next {
    opacity: var(--swap-state);
    filter: blur(calc((1 - var(--swap-state)) * 5px));
    transform: translateY(calc((var(--swap-state) - 1) * 120%));
  }

  .swap:focus-visible .swap-layer {
    transition-duration: 0ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .swap:hover {
      --swap-state: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .swap:active {
      transform: scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .swap-layer {
      transform: none;
      filter: none;
      transition: opacity 150ms var(--swap-ease);
    }
  }
</style>
