<div class="slider-card">
  <edge-aware-tooltip class="slider-field" style="--value: 0.5">
    <div class="rail" aria-hidden="true">
      <span class="rail-fill"></span>
      <span class="thumb-anchor"></span>
    </div>

    <span class="value-tooltip" aria-hidden="true"
      >Volume <span data-volume>50</span>%</span
    >
    <span class="tooltip-tip" aria-hidden="true"></span>

    <input
      class="volume-range"
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      aria-label="Volume"
      aria-valuetext="50 percent"
      data-position-input
    />
  </edge-aware-tooltip>
</div>

<script>
  class EdgeAwareTooltip extends HTMLElement {
    #controller: AbortController | undefined;

    connectedCallback() {
      this.#controller = new AbortController();
      const input = this.querySelector<HTMLInputElement>('[data-position-input]');
      const output = this.querySelector<HTMLElement>('[data-volume]');
      if (!input || !output) {
        throw new Error('EdgeAwareTooltip: missing required elements.');
      }

      const update = () => {
        const min = Number(input.min);
        const max = Number(input.max || '100');
        this.style.setProperty(
          '--value',
          String((input.valueAsNumber - min) / (max - min)),
        );
        output.textContent = input.value;
        input.setAttribute('aria-valuetext', `${input.value} percent`);
      };

      const { signal } = this.#controller;
      input.addEventListener('input', update, { signal });
      // A form reset restores the default value without an input event, once the reset event is over.
      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      this.closest('form')?.addEventListener(
        'reset',
        () => {
          clearTimeout(resetTimer);
          resetTimer = setTimeout(update);
        },
        { signal },
      );
      signal.addEventListener('abort', () => clearTimeout(resetTimer));
      update();
    }

    disconnectedCallback() {
      this.#controller?.abort();
    }
  }

  // A script in <head> would otherwise upgrade the element before its children are parsed.
  // The guard lets the script run twice on one page without throwing.
  const define = () => {
    if (!customElements.get('edge-aware-tooltip')) customElements.define('edge-aware-tooltip', EdgeAwareTooltip);
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', define);
  else define();
</script>

<style>
  .slider-card {
    --edge-tooltip-bg: var(--ink);
    --edge-track-bg: var(--line);
    --edge-thumb-bg: var(--bg);
    width: min(100%, 360px);
    padding: 64px 20px 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
  }

  .slider-field {
    position: relative;
    display: block;
    height: 44px;
    anchor-scope: --volume-thumb;
  }

  /* Keep input tracking direct, including when global styles set a transition duration. */
  .slider-field,
  .slider-field * {
    transition-property: none;
  }

  .rail {
    position: absolute;
    top: 20px;
    right: 12px;
    left: 12px;
    height: 4px;
    border-radius: 2px;
    background: var(--edge-track-bg);
    pointer-events: none;
  }

  .rail-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--text);
    clip-path: inset(0 calc((1 - var(--value)) * 100%) 0 0 round 2px);
  }

  /* Mirrors the native thumb so the same anchor works in every range implementation. */
  .thumb-anchor {
    position: absolute;
    top: -10px;
    left: calc(var(--value) * 100% - 12px);
    width: 24px;
    height: 24px;
    anchor-name: --volume-thumb;
  }

  .value-tooltip {
    position: absolute;
    bottom: 46px;
    left: clamp(
      0px,
      calc(12px + (100% - 24px) * var(--value) - 64px),
      calc(100% - 128px)
    );
    width: 128px;
    padding: 9px 12px;
    border-radius: 8px;
    background: var(--edge-tooltip-bg);
    color: var(--ink-text);
    font-size: 14px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 20px;
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
  }

  .tooltip-tip {
    position: absolute;
    bottom: 42px;
    left: calc(12px + (100% - 24px) * var(--value) - 4px);
    width: 8px;
    height: 8px;
    background: var(--edge-tooltip-bg);
    pointer-events: none;
    transform: rotate(45deg);
  }

  @supports (position-anchor: --volume-thumb) and (justify-self: anchor-center)
    and (anchor-scope: --volume-thumb) {
    .value-tooltip {
      position-anchor: --volume-thumb;
      bottom: calc(anchor(top) + 12px);
      left: auto;
      justify-self: anchor-center;
    }

    .tooltip-tip {
      position-anchor: --volume-thumb;
      bottom: calc(anchor(top) + 8px);
      left: calc(anchor(center) - 4px);
    }
  }

  .volume-range {
    position: relative;
    display: block;
    width: 100%;
    height: 44px;
    margin: 0;
    padding: 0;
    appearance: none;
    background: transparent;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .volume-range::-webkit-slider-runnable-track {
    height: 24px;
    background: transparent;
  }

  .volume-range::-moz-range-track {
    height: 24px;
    background: transparent;
  }

  .volume-range::-webkit-slider-thumb {
    width: 24px;
    height: 24px;
    appearance: none;
    border: 2px solid var(--text);
    border-radius: 50%;
    background: var(--edge-thumb-bg);
  }

  .volume-range::-moz-range-thumb {
    box-sizing: border-box;
    width: 24px;
    height: 24px;
    border: 2px solid var(--text);
    border-radius: 50%;
    background: var(--edge-thumb-bg);
  }

  .volume-range:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  @media (prefers-color-scheme: dark) {
    .slider-card {
      --edge-tooltip-bg: var(--surface-strong);
      --edge-track-bg: var(--line-strong);
      --edge-thumb-bg: var(--text);
    }
  }
</style>
