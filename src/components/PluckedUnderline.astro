  }

  .pluck-link:focus-visible {
    outline: 2px solid var(--focus-ring, var(--pluck-color));
    outline-offset: 2px;
  }

  .pluck-string {
    position: absolute;
    bottom: 4px;
    left: 10px;
    width: calc(100% - 20px);
    height: 12px;
    overflow: visible;
    pointer-events: none;
    /* Closed into the pluck point. The negative insets leave room for the swing. */
    clip-path: inset(-4px calc(100% - var(--pluck-x)) -4px var(--pluck-x));
    transition: clip-path var(--pluck-close) var(--pluck-ease-out);
  }

  .pluck-string path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    transform-box: view-box;
    transform-origin: 50% 50%;
    /* Restore the bend only once the underline has closed, such as after keyboard focus leaves. */
    transition: transform 0s var(--pluck-close);
  }

  /* The -1px sides keep the round caps. */
  .pluck-link:is([data-plucked], [data-inspect]) .pluck-string {
    clip-path: inset(-4px -1px);
    transition-duration: var(--pluck-open);
  }

  /* Flattening the bend with scaleY keeps the path data fixed; scaleY(0) would leave nothing to stroke. */
  .pluck-link:is([data-ringing], [data-inspect]) .pluck-string path {
    transform: scaleY(0.001);
    transition: transform var(--pluck-duration) var(--pluck-ease) 0s;
  }

  .pluck-link:focus-visible .pluck-string {
    clip-path: inset(-4px -1px);
    transition: none;
  }

  .pluck-link:focus-visible .pluck-string path {
    transform: scaleY(0.001);
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
