<script>
  // A longer string rings longer and lower, so each underline's timing comes from its own width.
  const MS_PER_PX = 13;
  const MIN_MS = 400;
  const MAX_MS = 1200;

  document.querySelectorAll<HTMLElement>('[data-pluck]').forEach((link) => {
    const string = link.querySelector('svg')!;
    const path = string.querySelector('path')!;
    let quiet = 0;

    new ResizeObserver(() => {
      const width = string.getBoundingClientRect().width;
      const ms = Math.min(Math.max(width * MS_PER_PX, MIN_MS), MAX_MS);
      link.style.setProperty('--pluck-duration', `${Math.round(ms)}ms`);
    }).observe(link);

    // Bend the string toward the pluck point, then release it from rest.
    function pluck(clientX: number) {
      const box = string.getBoundingClientRect();
      const x = Math.min(Math.max(((clientX - box.left) / box.width) * 100, 15), 85);
      // A longer string deflects further under the same pull.
      const bend = Math.min(Math.max(box.width / 18, 2), 5);
      link.removeAttribute('data-plucked');
      link.removeAttribute('data-ringing');
      string.style.transition = path.style.transition = 'none';
      link.style.setProperty('--pluck-x', `${x}%`);
      path.setAttribute('d', `M0 6 Q${x.toFixed(1)} ${(6 + bend * 2).toFixed(1)} 100 6`);
      // Apply the rest state now, so the transition starts from the new bend.
      void getComputedStyle(string).clipPath;
      void getComputedStyle(path).transform;
      string.style.transition = path.style.transition = '';
      link.setAttribute('data-plucked', '');
      link.setAttribute('data-ringing', '');
    }

    // Closing lets the string ring on. Reset the bend once the underline has closed.
    // getAnimations() without subtree sees only the SVG's clip, not the path's ring.
    function settle() {
      if (!link.hasAttribute('data-plucked') && !string.getAnimations().length) {
        link.removeAttribute('data-ringing');
      }
    }

    function release() {
      link.removeAttribute('data-plucked');
      settle();
    }

    for (const type of ['transitionend', 'transitioncancel']) {
      string.addEventListener(type, (event) => {
        if (event.target === string) settle();
      });
    }

    link.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') pluck(event.clientX);
    });
    link.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') release();
    });
    // Touch has no hover: a tap plucks, and the underline closes after the string rings out.
    link.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      pluck(event.clientX);
      clearTimeout(quiet);
      const ms = parseFloat(link.style.getPropertyValue('--pluck-duration')) || MAX_MS;
      quiet = setTimeout(release, ms + 400);
    });
  });
</script>

