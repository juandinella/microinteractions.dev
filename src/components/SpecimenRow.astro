---
import CurveGlyph from './CurveGlyph.astro';
import MorphArrow from './MorphArrow.astro';
import NewLabel from './NewLabel.astro';
import SpecimenDuration from './SpecimenDuration.astro';
import { previews } from '../data/previews';
import { curvePoints, type Specimen } from '../data/specimens';

interface Props {
  specimen: Specimen;
}

const { specimen: s } = Astro.props;
const { component: Preview, activeAttribute } = previews[s.id];
const isDrag = s.trigger === 'drag';
---

<article
  class="row"
  aria-labelledby={`row-${s.id}`}
  data-row
  data-trigger={s.trigger}
  data-duration={s.duration}
  data-confirmation-duration={s.confirmationDuration}
  data-release={s.release}
  data-curve={curvePoints(s.easing).join(',')}
  data-active-attribute={activeAttribute}
>
  <div class="stage" role="group" aria-label={`Try ${s.title}`} data-row-stage>
    <p class="hint" aria-hidden="true">
      <span class="hint-fine">{s.hint}</span><span class="hint-touch"
        >{s.touchHint ?? s.hint.replace(/^Hover/, 'Tap')}</span
      >
    </p>
    <Preview />
  </div>

  <div class="sheet">
    <div class="heading">
      <h3 id={`row-${s.id}`}>
        <a class="title" href={`/${s.id}/`} tabindex="-1">{s.title}</a>
      </h3>
      <NewLabel specimen={s} />
    </div>
    <p class="summary">{s.summary}</p>
    <dl>
      <div><dt>Trigger</dt><dd>{s.triggerLabel}</dd></div>
      <div>
        <dt>{isDrag ? 'Response' : 'Duration'}</dt>
        <dd><SpecimenDuration specimen={s} /></dd>
      </div>
      {s.detail ? (
        <div><dt>{s.detail.label}</dt><dd>{s.detail.value}</dd></div>
      ) : (
        <div>
          <dt>Easing</dt><dd class="easing">
            <CurveGlyph easing={s.easing} />{s.easingName}
          </dd>
        </div>
      )}
    </dl>
    <a class="open" href={`/${s.id}/`} aria-label={`Open the ${s.title} study`}>
      <span class="open-label">Open study</span>
      <MorphArrow />
    </a>
  </div>
</article>

<script>
  import { curveAt } from '../scripts/ease';
  import { traceHold } from '../scripts/trace-hold';
  import { traceHover } from '../scripts/trace-hover';
  import { traceSelect } from '../scripts/trace-select';

  // Moves the curve glyph's dot along the easing while the demo runs, like the study page's inspector.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-row]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-row-stage]');
    const dot = root.querySelector<SVGElement>('[data-curve-dot]');
    if (!stage || !dot) return;

    const place = (x: number, y: number) =>
      dot.setAttribute('transform', `translate(${x * 32} ${20 - y * 20})`);

    if (root.dataset.trigger === 'drag') {
      const input = stage.querySelector<HTMLInputElement>(
        '[data-position-input]',
      );
      if (!input) return;
      const render = () => {
        const progress =
          (Number(input.value) - Number(input.min)) /
          (Number(input.max) - Number(input.min));
        place(progress, progress);
      };
      input.addEventListener('input', render);
      render();
      return;
    }

    const duration = Number(root.dataset.duration);
    const confirmationDuration = Number(root.dataset.confirmationDuration || 0);
    const timelineDuration = duration + confirmationDuration;
    const release = Number(root.dataset.release || duration);
    const curve = (root.dataset.curve || '0,0,1,1').split(',').map(Number);
    // Elapsed share of the duration; counts back down when the demo reverses.
    let position = 0;
    let frame = 0;

    function trace(to: number, ms: number) {
      const d = reduceMotion.matches ? 0 : ms;
      cancelAnimationFrame(frame);
      const start = performance.now();
      const from = position;
      const tick = () => {
        const progress =
          d === 0 ? 1 : Math.min((performance.now() - start) / d, 1);
        position = from + (to - from) * progress;
        const x = Math.min((position * timelineDuration) / duration, 1);
        place(x, curveAt(curve, x));
        if (progress < 1) frame = requestAnimationFrame(tick);
      };
      tick();
    }

    if (root.dataset.trigger === 'hover') {
      const attribute = root.dataset.activeAttribute;
      traceHover(
        stage,
        (progress, curveX = progress) => place(curveX, curveAt(curve, curveX)),
        curve,
        attribute ? { duration, attribute } : undefined,
      );
    }

    if (root.dataset.trigger === 'hold') {
      const button = stage.querySelector<HTMLElement>('button');
      if (button)
        traceHold(button, trace, duration, release, confirmationDuration);
    }

    if (root.dataset.trigger === 'select') {
      traceSelect(stage, (progress) => place(progress, curveAt(curve, progress)));
    }
  });
</script>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
    padding: 24px 0;
  }

  .stage {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 260px;
    place-items: center;
    padding: 44px 24px 28px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    isolation: isolate;
  }

  .hint {
    position: absolute;
    top: 14px;
    left: 16px;
    margin: 0;
    color: var(--meta);
    font-family: var(--font-mono);
    font-size: 11px;
    pointer-events: none;
    user-select: none;
  }

  .hint-touch {
    display: none;
  }

  @media not ((hover: hover) and (pointer: fine)) {
    .hint-fine {
      display: none;
    }

    .hint-touch {
      display: inline;
    }
  }

  .sheet {
    min-width: 0;
  }

  .heading {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: var(--tracking-headline);
    line-height: 1.3;
  }

  /* A pointer shortcut to the study; keyboard users reach the same page through "Open study". */
  .title {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 150ms ease-out;
  }

  .summary {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  dl {
    display: grid;
    gap: 8px;
    margin: 20px 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  dl div {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    align-items: center;
    min-height: 22px;
  }

  dt {
    color: var(--quiet);
  }

  dd {
    margin: 0;
    color: var(--text);
  }

  .easing {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* An underlined text action; the chevron morph study turns its chevron into an arrow on hover. */
  .open {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 2px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 12px;
    touch-action: manipulation;
  }

  .open-label {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .open:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  .open:focus-visible .open-label {
    text-decoration-color: var(--text);
  }

  @media (hover: hover) and (pointer: fine) {
    .title:hover {
      text-decoration-color: var(--line-strong);
    }

    .open:hover .open-label,
    .sheet:has(.title:hover) .open-label {
      text-decoration-color: var(--text);
    }

    /* Hovering the title previews the same action on "Open study": MorphArrow's chevron becomes an arrow. */
    .sheet:has(.title:hover) .open :global(:is(.chevron, .stem)) {
      transform: translateX(2px);
      transition-duration: 180ms;
    }

    .sheet:has(.title:hover) .open :global(.stem) {
      clip-path: inset(0);
    }
  }

  @media (max-width: 780px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding: 24px 0;
    }
  }
</style>
