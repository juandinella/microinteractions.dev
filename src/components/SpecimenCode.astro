---
import { Code } from 'astro:components';
import { getEntry } from 'astro:content';
import SourceTabs from './SourceTabs.tsx';
import styles from './SourceTabs.module.css';
import StudyHeading from './StudyHeading.astro';
import { previews } from '../data/previews';
import { buildPrompt } from '../data/prompt';
import { sourceFiles, tailwindSetupNote, tailwindSourceFiles } from '../data/source';
import { specimens, type SpecimenId } from '../data/specimens';
import { codeTheme } from '../styles/code-theme';
import '../styles/code.css';

interface Props {
  specimen: SpecimenId;
}

const { source, tailwindSource, filename, includeScript, reducedMotion } = previews[Astro.props.specimen];
const prefix = filename.replace('.astro', '').toLowerCase();
const study = specimens.find(({ id }) => id === Astro.props.specimen)!;
const studyUrl = new URL(`/${study.id}/`, Astro.site);
const prompt = (await getEntry('studies', study.id))?.data.prompt;
// The prompt leads when a study has one; the code formats follow.
const variants = [
  ...(prompt ? [{
    id: 'prompt',
    label: 'Prompt',
    views: [{ id: 'prompt', label: 'Prompt', lang: 'plaintext', code: buildPrompt(study, prompt) }],
    externalScript: '',
  }] : []),
  { id: 'css', label: 'CSS', views: sourceFiles(source, includeScript, reducedMotion), externalScript: '' },
  ...(tailwindSource ? [{
    id: 'tailwind',
    label: 'Tailwind',
    views: tailwindSourceFiles(tailwindSource, includeScript ? source : ''),
    externalScript: 'https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4',
  }] : []),
].map((variant) => {
  const code = Object.fromEntries(variant.views.map((view) => [view.id, view.code]));
  const sections = { ...code };
  if (variant.id === 'tailwind') {
    sections.html = `<style type="text/tailwindcss">\n${sections.css}\n</style>\n\n${sections.html}`;
    delete sections.css;
  }
  return {
    ...variant,
    code,
    codepenData: JSON.stringify({
      title: `${study.title} · Microinteractions`,
      description: `${study.summary}\n\n${studyUrl.href}`,
      ...sections,
      html_pre_processor: 'none',
      css_pre_processor: 'none',
      js_pre_processor: 'none',
      js_external: variant.externalScript,
      layout: 'left',
      head: '<meta name="viewport" content="width=device-width, initial-scale=1">\n<style>body { margin: 8px; }</style>',
    }),
  };
});
---

<section class="source" data-source aria-labelledby="implementation">
  <header class="source-heading">
    <StudyHeading id="implementation">Implementation</StudyHeading>
    {variants.length > 1 && <fieldset class="source-formats" data-source-formats style={`--formats: ${variants.length}`}>
      <legend class="sr-only">Implementation format</legend>
      <span class="source-format-thumb" aria-hidden="true"></span>
      {variants.map((variant, index) => <label class="source-format">
        <input type="radio" name={`${prefix}-format`} value={variant.id} checked={index === 0} data-source-format aria-controls={`${prefix}-${variant.id}-source`} />
        <span>{variant.label}</span>
      </label>)}
    </fieldset>}
  </header>
  <div id={`${prefix}-variants`}>
    {variants.map((variant) => <div id={`${prefix}-${variant.id}-source`} data-source-variant={variant.id}>
      <SourceTabs client:load views={variant.views.map(({ id, label }) => ({ id, label }))}>
        {variant.id !== 'prompt' && <form slot="actions" action="https://codepen.io/cpe/pen/define" method="post" target="_blank" rel="noopener">
          <input type="hidden" name="data" value={variant.codepenData} />
          <button class={styles.action} type="submit" aria-label="Edit on CodePen (opens in a new tab)">
            <span>Edit on CodePen</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
          </button>
        </form>}
        {/* Astro renders nothing when a React island gets dynamically named slots, so each view has a fixed one. */}
        {variant.code.html && <div slot="html" class:list={{ wrap: variant.id === 'tailwind' }}><Code code={variant.code.html} lang="html" theme={codeTheme} /></div>}
        {variant.code.css && <div slot="css"><Code code={variant.code.css} lang="css" theme={codeTheme} /></div>}
        {variant.code.js && <div slot="js"><Code code={variant.code.js} lang="js" theme={codeTheme} /></div>}
        {variant.code.prompt && <div slot="prompt" class="wrap"><Code code={variant.code.prompt} lang="plaintext" theme={codeTheme} /></div>}
      </SourceTabs>
      {variant.id === 'tailwind' && <p class="source-note">{tailwindSetupNote(includeScript)}</p>}
    </div>)}
  </div>
</section>

<style>
  .source { min-width: 0; }
  .source [hidden] { display: none; }
  .source:has([data-source-format]) [data-source-variant] { display: none; }
  .source:has([data-source-format][value='prompt']:checked) [data-source-variant='prompt'],
  .source:has([data-source-format][value='css']:checked) [data-source-variant='css'],
  .source:has([data-source-format][value='tailwind']:checked) [data-source-variant='tailwind'] { display: block; }
  .source-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-bottom: 16px; }
  .source-formats { position: relative; isolation: isolate; display: grid; grid-template-columns: repeat(var(--formats), 72px); min-width: 0; margin: 0; padding: 0; border: 0; font: 11px var(--font-mono); }
  .source-formats::before { content: ''; position: absolute; z-index: -2; inset: 6px 0; border-radius: 999px; background: var(--surface-strong); }
  .source-format-thumb { position: absolute; z-index: -1; top: 8px; bottom: 8px; left: 2px; width: calc((100% - 4px) / var(--formats)); border-radius: 999px; background: var(--text); transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1); pointer-events: none; }
  .source-formats:has(.source-format:nth-of-type(2) input:checked) .source-format-thumb { transform: translateX(100%); }
  .source-formats:has(.source-format:nth-of-type(3) input:checked) .source-format-thumb { transform: translateX(200%); }
  .source-formats:has(input:focus-visible) .source-format-thumb { transition: none; }
  .source-format { position: relative; display: flex; }
  .source-format input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; touch-action: manipulation; }
  .source-format span { display: flex; width: 100%; align-items: center; justify-content: center; min-height: 44px; border-radius: 999px; color: var(--muted); }
  .source-format input:checked + span { color: var(--bg); }
  .source-format input:focus-visible + span { outline: 2px solid var(--text); outline-offset: -2px; }
  .source-note { margin: 12px 0 0; color: var(--muted); font: 11px/1.6 var(--font-mono); }
  form { display: flex; margin: 0; }
  .wrap :global(pre) { white-space: pre-wrap; overflow-wrap: anywhere; hyphens: none; }
  @media (hover: hover) and (pointer: fine) {
    .source-format input:not(:checked):hover + span { color: var(--text); }
  }
  @media (prefers-reduced-motion: reduce) {
    .source-format-thumb { transition: none; }
  }
</style>
