<style is:global>
  @theme {
    --color-wd: oklch(0.23 0.012 258.74);
    --color-wd-muted: oklch(0.44 0.014 258.74);
    --color-wd-quiet: oklch(0.55 0.012 258.74);
    --color-wd-line: oklch(0.9 0.003 258.74);
    --color-wd-paper: oklch(0.995 0.002 258.74);
  }

  /* Registered, so the script reads them in px whatever unit they're written in. */
  @property --wd-dot {
    syntax: '<length>';
    inherits: true;
    initial-value: 6px;
  }

  @property --wd-pill {
    syntax: '<length>';
    inherits: true;
    initial-value: 12px;
  }

  @property --wd-gap {
    syntax: '<length>';
    inherits: true;
    initial-value: 24px;
  }

  @property --wd-ring {
    syntax: '<length>';
    inherits: true;
    initial-value: 16px;
  }
</style>
