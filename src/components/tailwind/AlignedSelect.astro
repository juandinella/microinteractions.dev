<script>
  // The menu fades in over 70ms and closes in one frame: a pick should show the new value at once, not the old menu
  // fading over it. Opening from the keyboard doesn't fade. The fade is opacity only, so it stays with reduced motion.
  const FADE_IN = 70;
  // The release of the opening press lands on the current option, which now sits under the pointer. It only picks
  // if the pointer travelled more than this since the press, or every click would re-pick the value and close.
  const SLOP = 10;
  // A press dragged out of the menu and released closes it; one that never moved leaves it open.
  const DRAG_OUT = 2;
  // The aligned menu needs room. A trigger this close to an edge of the window, or a menu cut so short that less than
  // MIN_HEIGHT of list is left, opens below the trigger instead (above when below is shorter).
  const EDGE = 20;
  const MIN_HEIGHT = 104;
  // The menu never touches the window's edge; a dropdown sits this far from its trigger.
  const GAP = 8;
  const OFFSET = 4;
  // Resting on a scroll arrow scrolls the list at about one row every 80ms.
  const ARROW_SPEED = 0.4;
  // Typed letters build one search that resets this long after the last key.
  const TYPEAHEAD_RESET = 1000;
  // Page Up and Page Down move this many options.
  const PAGE = 10;
  // iOS follows a tap with mouse events at the same spot; mouse events this soon after a touch ends are those.
  const TOUCH_ECHO = 50;

  let listCount = 0;

  class AlignedSelectElement extends HTMLElement {
    #controller: AbortController | undefined;
    // The option selected when the element first connected, which a form reset restores.
    #initial: number | undefined;
    #choose: ((value: string) => void) | undefined;

    // An option's value is its data-value, or its label when it has none.
    get value() {
      const option = this.querySelector<HTMLElement>('[role="option"][aria-selected="true"]');
      return option ? (option.dataset.value ?? option.querySelector('[data-label]')!.textContent!.trim()) : '';
    }

    // Setting the value selects that option without a change event, as on a native select. A value that isn't an
    // option changes nothing.
    set value(value: string) {
      this.#choose?.(value);
    }

    connectedCallback() {
      this.#controller = new AbortController();
      const { signal } = this.#controller;
      const trigger = this.querySelector<HTMLButtonElement>('[data-trigger]');
      const display = this.querySelector<HTMLElement>('[data-display]');
      const menu = this.querySelector<HTMLElement>('[data-menu]');
      const list = this.querySelector<HTMLElement>('[data-list]');
      const options = [...this.querySelectorAll<HTMLElement>('[role="option"]')];
      const up = this.querySelector<HTMLElement>('[data-arrow="up"]');
      const down = this.querySelector<HTMLElement>('[data-arrow="down"]');
      if (!trigger || !display || !menu || !list || !up || !down || !options.length || !options.every((o) => o.querySelector('[data-label]'))) {
        throw new Error('AlignedSelect: needs a trigger with a display, a popover menu with a list of options that each have a label, and two scroll arrows.');
      }

      // aria-activedescendant points at an option by id.
      list.id ||= `aligned-select-${++listCount}`;
      options.forEach((option, i) => (option.id ||= `${list.id}-${i}`));
      trigger.setAttribute('aria-controls', list.id);

      let isOpen = false;
      let active = -1;
      // The mouse press that opened the menu is still down: its release is the press-drag-release decision.
      let pressing = false;
      let downX = 0;
      let downY = 0;
      let travelled = 0;
      // The pointer type of the last press anywhere on the page, for dismissing on a touch's click.
      let pressedWith = 'mouse';
      // The trigger's own press, read by its click. A click with no press behind it came from assistive technology.
      let triggerPress: string | null = null;
      let touchEndedAt = -Infinity;
      // The mouse's last position on the page, to tell a move from the one WebKit repeats after a layout change.
      let mouseX = 0;
      let mouseY = 0;
      let mouseKnown = false;
      // Where the trigger was when the menu was placed.
      let placedX = 0;
      let placedY = 0;
      let arrowFrame = 0;
      let search = '';
      let searchTimer = 0;

      const selected = () => Math.max(0, options.findIndex((o) => o.getAttribute('aria-selected') === 'true'));
      // The label is what the trigger shows and typeahead matches; the value is what a form submits.
      const labelOf = (option: HTMLElement) => option.querySelector('[data-label]')!.textContent!.trim();
      const valueOf = (option: HTMLElement) => option.dataset.value ?? labelOf(option);

      // Placement

      const bounds = () => {
        const { clientWidth, clientHeight } = document.documentElement;
        return { width: clientWidth, height: clientHeight };
      };

      const place = (top: number, left: number, width: number, height: number) => {
        Object.assign(menu.style, { top: `${top}px`, left: `${left}px`, width: `${width}px`, height: `${height}px` });
      };

      // Aligned: the current option's label sits on the trigger's value, both axes. When the menu would leave the
      // window it is cut at the edge and the list scrolls, so the option still sits on the trigger. Returns false
      // when that doesn't work, and the menu opens below instead.
      const placeAligned = (index: number) => {
        const view = bounds();
        const box = trigger.getBoundingClientRect();
        if (box.top < EDGE || view.height - box.bottom < EDGE) return false;

        // Measured at full height and unscrolled. Text centers meet, not row centers: the trigger's border moves its
        // text by a pixel. offsetHeight counts the menu's border, so a short list never overflows by it.
        const shell = menu.getBoundingClientRect();
        const value = display.getBoundingClientRect();
        const row = options[index].getBoundingClientRect();
        const label = options[index].querySelector('[data-label]')!.getBoundingClientRect();
        const full = menu.offsetHeight;
        const desiredTop = value.top + value.height / 2 - (label.top - shell.top + label.height / 2);
        const top = Math.max(desiredTop, GAP);
        const bottom = Math.min(desiredTop + full, view.height - GAP);
        const height = bottom - top;
        if (height < Math.min(MIN_HEIGHT, full)) return false;
        // A cut edge shows a scroll arrow over the list; the current option can't sit under it.
        const rowTop = row.top - shell.top + desiredTop;
        const arrow = up.offsetHeight;
        if (top > desiredTop && rowTop - top < arrow) return false;
        if (bottom < desiredTop + full && bottom - (rowTop + row.height) < arrow) return false;

        // The label's start edge meets the value's, and the menu reaches at least the trigger's far edge.
        // Both texts are the same string, so their boxes are the same width and their ends meet too.
        // Never wider than the window: longer labels end in an ellipsis.
        const rtl = getComputedStyle(this).direction === 'rtl';
        const widest = view.width - 2 * GAP;
        let left: number;
        let width: number;
        if (rtl) {
          const right = value.right + (shell.right - label.right);
          width = Math.min(Math.max(shell.width, right - box.left), widest);
          left = right - width;
        } else {
          left = value.left - (label.left - shell.left);
          width = Math.min(Math.max(shell.width, box.right - left), widest);
        }
        left = Math.min(Math.max(left, GAP), view.width - GAP - width);
        place(top, left, width, height);
        list.scrollTop = top - desiredTop;
        return true;
      };

      // Below: a classic dropdown under the trigger, above it when below is the shorter side, scrolled to the current
      // option. Touch always opens here, because the finger covers the trigger.
      const placeBelow = (index: number) => {
        const view = bounds();
        const box = trigger.getBoundingClientRect();
        const shell = menu.getBoundingClientRect();
        const full = menu.offsetHeight;
        const below = view.height - GAP - (box.bottom + OFFSET);
        const above = box.top - OFFSET - GAP;
        const downward = below >= Math.min(full, MIN_HEIGHT) || below >= above;
        const height = Math.max(Math.min(full, downward ? below : above), 0);
        const top = downward ? box.bottom + OFFSET : box.top - OFFSET - height;
        const width = Math.min(Math.max(shell.width, box.width), view.width - 2 * GAP);
        const rtl = getComputedStyle(this).direction === 'rtl';
        const left = Math.min(Math.max(rtl ? box.right - width : box.left, GAP), view.width - GAP - width);
        place(top, left, width, height);
        const option = options[index];
        list.scrollTop = option.offsetTop - (list.clientHeight - option.offsetHeight) / 2;
      };

      // Scroll arrows: macOS says there is more with arrows, not a scrollbar. Wheel, trackpad and touch still scroll.

      const updateArrows = () => {
        menu.toggleAttribute('data-up', list.scrollTop > 1);
        menu.toggleAttribute('data-down', list.scrollTop < list.scrollHeight - list.clientHeight - 1);
      };

      const stopArrow = () => {
        cancelAnimationFrame(arrowFrame);
        arrowFrame = 0;
      };

      for (const [arrow, direction] of [[up, -1], [down, 1]] as const) {
        // Started by a mouse that moved over the arrow: not by one the arrow appeared under after a keyboard move
        // (WebKit sends a pointermove at the same spot when the layout changes), and not by the mouse events iOS
        // sends after a tap. The document's listener records the position after this one has read it.
        arrow.addEventListener(
          'pointermove',
          (event) => {
            const moved = mouseKnown && (event.clientX !== mouseX || event.clientY !== mouseY);
            if (event.pointerType !== 'mouse' || !moved || !isOpen || arrowFrame || performance.now() - touchEndedAt < TOUCH_ECHO) return;
            let last = performance.now();
            // A frame's timestamp is when the frame began, which can be before this event: never step backwards.
            const step = (now: number) => {
              list.scrollTop += direction * Math.max(0, now - last) * ARROW_SPEED;
              last = now;
              updateArrows();
              const end = direction < 0 ? list.scrollTop <= 0 : list.scrollTop >= list.scrollHeight - list.clientHeight;
              arrowFrame = end ? 0 : requestAnimationFrame(step);
            };
            arrowFrame = requestAnimationFrame(step);
          },
          { signal },
        );
        arrow.addEventListener('pointerleave', stopArrow, { signal });
        // The arrows sit over the list, not in it: a wheel over them would scroll the page and close the menu.
        arrow.addEventListener(
          'wheel',
          (event) => {
            event.preventDefault();
            const unit = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16 : event.deltaMode === WheelEvent.DOM_DELTA_PAGE ? list.clientHeight : 1;
            list.scrollTop += event.deltaY * unit;
          },
          { passive: false, signal },
        );
      }

      list.addEventListener('scroll', updateArrows, { passive: true, signal });

      // Highlight

      // Only the keyboard scrolls the list to the highlight, and only as far as it takes to clear the arrows.
      // A half-visible row under the pointer must not run away from it.
      const reveal = (option: HTMLElement) => {
        const arrow = up.offsetHeight;
        const top = option.offsetTop - list.scrollTop;
        if (top < arrow) list.scrollTop = option.offsetTop - arrow;
        else if (top + option.offsetHeight > list.clientHeight - arrow) {
          list.scrollTop = option.offsetTop + option.offsetHeight - list.clientHeight + arrow;
        }
      };

      // `keyed`: the keyboard moved the highlight. It then scrolls into view and gets a focus ring, because a menu
      // opened from the keyboard covers the trigger and its ring. A mouse highlight stays soft: the pointer is the cue.
      const setActive = (index: number, keyed: boolean) => {
        options.forEach((option, i) => option.toggleAttribute('data-highlighted', i === index));
        menu.toggleAttribute('data-keyed', keyed);
        active = index;
        if (index < 0) {
          trigger.removeAttribute('aria-activedescendant');
          return;
        }
        trigger.setAttribute('aria-activedescendant', options[index].id);
        if (keyed) reveal(options[index]);
      };

      // Open, close, pick

      const open = (via: 'mouse' | 'touch' | 'keyboard') => {
        if (isOpen) return;
        isOpen = true;
        menu.removeAttribute('style');
        menu.showPopover();
        list.scrollTop = 0;
        const index = selected();
        if (via === 'touch' || !placeAligned(index)) placeBelow(index);
        const placed = trigger.getBoundingClientRect();
        placedX = placed.left;
        placedY = placed.top;
        updateArrows();
        // A select highlights its current value however it opened, so Enter right away keeps it.
        setActive(index, via === 'keyboard');
        trigger.setAttribute('aria-expanded', 'true');
        if (via !== 'keyboard') menu.animate([{ opacity: 0 }, { opacity: 1 }], { duration: FADE_IN, easing: 'ease-out' });
      };

      const close = () => {
        if (!isOpen) return;
        isOpen = false;
        pressing = false;
        stopArrow();
        setActive(-1, false);
        trigger.setAttribute('aria-expanded', 'false');
        menu.getAnimations().forEach((animation) => animation.cancel());
        menu.hidePopover();
      };

      // A name makes it a form field, as on a native select: a hidden input carries the value, so the form submits
      // it and FormData reads it. A disabled trigger (or fieldset) leaves it out.
      const name = this.getAttribute('name');
      let input = this.querySelector<HTMLInputElement>(':scope > input[type="hidden"]');
      if (name && !input) {
        input = document.createElement('input');
        input.type = 'hidden';
        this.append(input);
      }
      if (input && name) input.name = name;
      this.#initial ??= selected();
      const initial = this.#initial;

      const choose = (index: number, notify = true) => {
        const changed = index !== selected();
        options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
        display.textContent = labelOf(options[index]);
        if (input) input.value = valueOf(options[index]);
        if (changed && notify) {
          this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
          this.dispatchEvent(new Event('change', { bubbles: true }));
        }
      };
      // Exactly one option is selected from here on. A reconnect (the element moved) keeps what was picked.
      choose(selected(), false);
      this.#choose = (value) => {
        const index = options.findIndex((option) => valueOf(option) === value);
        if (index >= 0) choose(index, false);
      };
      signal.addEventListener('abort', () => (this.#choose = undefined));

      const disable = () => {
        if (input) input.disabled = trigger.hasAttribute('disabled');
        if (trigger.matches(':disabled')) close();
      };
      disable();
      const observer = new MutationObserver(disable);
      observer.observe(trigger, { attributes: true, attributeFilter: ['disabled'] });

      // A form reset restores the option selected at first without a change event, as a native select does. It waits
      // for the reset event to finish, since a listener can still cancel it.
      this.closest('form')?.addEventListener(
        'reset',
        (event) =>
          setTimeout(() => {
            if (event.defaultPrevented) return;
            close();
            choose(initial, false);
          }),
        { signal },
      );

      const pick = (index: number) => {
        choose(index);
        close();
      };

      const optionAt = (target: EventTarget | null) => {
        const option = (target as Element | null)?.closest?.<HTMLElement>('[role="option"]');
        return option ? options.indexOf(option) : -1;
      };

      // Typeahead: the same letter again cycles through the options that start with it.
      const typeahead = (event: KeyboardEvent, from: number) => {
        if (event.key.length !== 1 || event.metaKey || event.ctrlKey || event.altKey) return null;
        if (event.key === ' ' && search === '') return null;
        search += event.key.toLowerCase();
        clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => (search = ''), TYPEAHEAD_RESET);
        const query = [...search].every((c) => c === search[0]) ? search[0] : search;
        const start = query.length === 1 ? from + 1 : Math.max(from, 0);
        for (let i = 0; i < options.length; i++) {
          const index = (start + i) % options.length;
          if (labelOf(options[index]).toLowerCase().startsWith(query)) return index;
        }
        return from;
      };

      // Pointer

      trigger.addEventListener(
        'pointerdown',
        (event) => {
          // Chromium still sends pointer events to a disabled button.
          if (trigger.matches(':disabled')) return;
          triggerPress = event.pointerType;
          if (event.pointerType !== 'mouse' || event.button !== 0 || event.ctrlKey) return;
          // A mouse opens on press, so press, drag and release picks in one motion. Focus stays on the trigger
          // (aria-activedescendant), and preventing the default keeps the drag from selecting text.
          event.preventDefault();
          trigger.focus({ preventScroll: true });
          if (isOpen) return close();
          open('mouse');
          pressing = true;
          downX = event.clientX;
          downY = event.clientY;
          travelled = 0;
        },
        { signal },
      );

      trigger.addEventListener(
        'click',
        (event) => {
          const press = triggerPress;
          triggerPress = null;
          // A mouse already opened or closed the menu on its press.
          if (press === 'mouse') return;
          // detail 0: a screen reader's click, since the keys are handled on keydown.
          if (event.detail === 0) return isOpen ? close() : open('keyboard');
          // Touch and pen open on click, so a scroll that starts on the trigger never opens it. A click with no press
          // behind it (VoiceOver on iOS, TalkBack) opens the same way.
          if (isOpen) close();
          else open('touch');
        },
        { signal },
      );

      // Presses inside the menu keep focus on the trigger and select no text.
      menu.addEventListener('pointerdown', (event) => event.preventDefault(), { signal });

      // The highlight follows a mouse that moved, never an idle pointer over a list the keyboard scrolled.
      menu.addEventListener(
        'pointermove',
        (event) => {
          if (event.pointerType !== 'mouse') return;
          const index = optionAt(event.target);
          if (index >= 0 && index !== active) setActive(index, false);
        },
        { signal },
      );
      menu.addEventListener('pointerleave', (event) => event.pointerType === 'mouse' && setActive(-1, false), { signal });

      document.addEventListener(
        'pointermove',
        (event) => {
          if (pressing) travelled = Math.max(travelled, Math.hypot(event.clientX - downX, event.clientY - downY));
          if (event.pointerType !== 'mouse') return;
          mouseX = event.clientX;
          mouseY = event.clientY;
          mouseKnown = true;
        },
        { signal },
      );

      document.addEventListener(
        'pointerup',
        (event) => {
          if (event.pointerType !== 'mouse') touchEndedAt = performance.now();
          // A press that didn't end in a click on the trigger (it was released over the menu) is over.
          setTimeout(() => (triggerPress = null));
          if (!pressing || event.pointerType !== 'mouse') return;
          pressing = false;
          const index = optionAt(event.target);
          if (index >= 0) {
            if (travelled > SLOP) pick(index);
            return;
          }
          // Dragged out of the menu and let go: the menu was abandoned.
          const target = event.target as Node;
          if (!menu.contains(target) && !trigger.contains(target) && travelled > DRAG_OUT) close();
        },
        { signal },
      );

      document.addEventListener('pointercancel', () => (pressing = false), { signal });

      // Once the opening press is over, a mouse released over an option picks it, wherever the press began in the
      // menu: press, drag and release works in an open menu too. During the opening press this listener runs first
      // and leaves the release to the guard below. A finger picks the option it went down and came up on; scrolling
      // the list cancels the pointer, so a scroll that starts on an option picks nothing. WebKit fires no click for a
      // touch whose pointerdown was prevented, so a tap can't wait for one.
      let tapped = -1;
      menu.addEventListener('pointerdown', (event) => (tapped = event.pointerType === 'mouse' ? -1 : optionAt(event.target)), { signal });
      menu.addEventListener('pointercancel', () => (tapped = -1), { signal });
      menu.addEventListener(
        'pointerup',
        (event) => {
          const index = optionAt(event.target);
          if (event.pointerType === 'mouse') {
            if (event.button === 0 && !pressing && index >= 0) pick(index);
          } else if (index >= 0 && index === tapped) {
            pick(index);
          }
          tapped = -1;
        },
        { signal },
      );

      // Assistive technology picks on click (and a touch browser that still sends one picks the same option again,
      // which changes nothing); a mouse already picked on release.
      menu.addEventListener(
        'click',
        (event) => {
          if (event.detail !== 0 && pressedWith === 'mouse') return;
          const index = optionAt(event.target);
          if (index >= 0) pick(index);
        },
        { signal },
      );

      // A mouse dismisses on press. Touch dismisses on click, so a scroll that starts outside doesn't close the menu.
      const outside = (target: EventTarget | null) => !this.contains(target as Node);
      document.addEventListener(
        'pointerdown',
        (event) => {
          pressedWith = event.pointerType;
          if (isOpen && event.pointerType === 'mouse' && outside(event.target)) close();
        },
        { capture: true, signal },
      );
      document.addEventListener(
        'click',
        (event) => {
          if (isOpen && pressedWith !== 'mouse' && outside(event.target)) close();
        },
        { capture: true, signal },
      );

      // Keyboard: the APG select-only combobox. Focus never leaves the trigger.

      trigger.addEventListener(
        'keydown',
        (event) => {
          // Holding Enter or Space would open, pick, open again at the key repeat rate. Arrows keep their repeat.
          if (event.repeat && (event.key === 'Enter' || event.key === ' ')) {
            event.preventDefault();
            return;
          }
          if (!isOpen) {
            // Space during a typeahead search is part of the search ("New York"), not an open.
            if (['ArrowDown', 'ArrowUp', 'Enter'].includes(event.key) || (event.key === ' ' && search === '')) {
              event.preventDefault();
              open('keyboard');
              return;
            }
            // Typing on the closed trigger changes the value, as a native select does.
            const found = typeahead(event, selected());
            if (found !== null) {
              event.preventDefault();
              choose(found);
            }
            return;
          }

          const last = options.length - 1;
          const moves: Record<string, number> = {
            ArrowDown: Math.min(active + 1, last),
            ArrowUp: Math.max(active - 1, 0),
            Home: 0,
            End: last,
            PageDown: Math.min(active + PAGE, last),
            PageUp: Math.max(active - PAGE, 0),
          };
          if (event.key in moves) {
            event.preventDefault();
            setActive(moves[event.key], true);
          } else if (event.key === 'Enter' || (event.key === ' ' && search === '')) {
            event.preventDefault();
            if (active >= 0) pick(active);
            else close();
          } else if (event.key === 'Escape') {
            // Escape closes one layer: a dialog or menu around the select keeps its own Escape for the next press.
            event.preventDefault();
            event.stopPropagation();
            close();
          } else if (event.key === 'Tab') {
            close();
          } else {
            const found = typeahead(event, active);
            if (found !== null) {
              event.preventDefault();
              setActive(found, true);
            }
          }
        },
        { signal },
      );

      // Firefox fires a button's click on Space keyup even when keydown was prevented.
      trigger.addEventListener('keyup', (event) => event.key === ' ' && event.preventDefault(), { signal });

      // Focus taken elsewhere (a click on something focusable, a script) leaves the menu behind.
      trigger.addEventListener('blur', close, { signal });

      // The menu is placed in window pixels: a scroll that moves the trigger, or a resize, would leave it behind, so
      // it closes. The trigger is measured rather than the scroll's target: other scrolling areas don't move it, and
      // a scroll event arrives a frame late, so the one from focusing the trigger can land after a keyboard open.
      document.addEventListener(
        'scroll',
        (event) => {
          if (!isOpen || event.target === list) return;
          const now = trigger.getBoundingClientRect();
          if (Math.abs(now.left - placedX) > 1 || Math.abs(now.top - placedY) > 1) close();
        },
        { capture: true, passive: true, signal },
      );
      window.addEventListener('resize', close, { signal });
      document.addEventListener('visibilitychange', () => document.hidden && close(), { signal });

      signal.addEventListener('abort', () => {
        clearTimeout(searchTimer);
        observer.disconnect();
        close();
      });
    }

    disconnectedCallback() {
      this.#controller?.abort();
    }
  }

  // A script in <head> would otherwise upgrade the element before its children are parsed.
  // The guard lets the script run twice on one page without throwing.
  const define = () => {
    if (!customElements.get('aligned-select')) customElements.define('aligned-select', AlignedSelectElement);
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', define);
  else define();
</script>

<style is:global>
  @theme {
    --color-als: oklch(0.23 0.012 258.74);
    --color-als-muted: oklch(0.44 0.014 258.74);
    --color-als-quiet: oklch(0.55 0.012 258.74);
    --color-als-bg: oklch(0.995 0.002 258.74);
    --color-als-surface: oklch(0.972 0.002 258.74);
    --color-als-strong: oklch(0.925 0.004 258.74);
    --color-als-hover: oklch(0.902 0.004 258.74);
    --color-als-line: oklch(0.9 0.003 258.74);
    --color-als-line-strong: oklch(0.79 0.006 258.74);
    /* The open menu and its scroll arrows: raised surfaces get lighter in the dark. */
    --color-als-raised: var(--color-als-bg);
    --color-als-menu-line: var(--color-als-line);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-als: oklch(0.92 0.006 258.74);
      --color-als-muted: oklch(0.74 0.01 258.74);
      --color-als-quiet: oklch(0.66 0.012 258.74);
      --color-als-bg: oklch(0.19 0.008 258.74);
      --color-als-surface: oklch(0.23 0.009 258.74);
      --color-als-strong: oklch(0.3 0.012 258.74);
      --color-als-hover: oklch(0.35 0.014 258.74);
      --color-als-line: oklch(0.32 0.012 258.74);
      --color-als-line-strong: oklch(0.49 0.014 258.74);
      --color-als-raised: var(--color-als-surface);
      /* A shadow barely shows on a dark page and the menu is the card's color, so its border carries the edge:
         3.2:1 against the card, past the 3:1 a component's boundary needs. Its dark shadow is a dark: class. */
      --color-als-menu-line: oklch(0.53 0.014 258.74);
    }
  }
</style>
