<hold-to-confirm class="relative inline-flex">
  <button
    type="button"
    aria-label="Hold to confirm"
    data-state="idle"
    class="group/hold relative isolate inline-grid min-h-12 min-w-52 place-items-center overflow-hidden rounded-full px-5.5 py-2.5 text-hold-ink font-sans text-base/[1.2] font-medium tracking-[-0.01em] whitespace-nowrap cursor-pointer select-none touch-none [-webkit-touch-callout:none] [--hold-confirmed:0] [--hold-state:0ms] [--hold-release:0ms] data-[state=confirmed]:[--hold-confirmed:1] motion-safe:data-[input=pointer]:[--hold-state:160ms] motion-safe:data-[input=pointer]:[--hold-release:180ms] before:absolute before:inset-0 before:-z-1 before:rounded-[inherit] before:bg-hold before:transition-[background-color,transform] before:duration-[150ms,140ms] before:ease-[ease,var(--ease-hold)] pointer-fine:hover:before:bg-hold-hover motion-safe:data-pressed:before:transform-[scale(0.98)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-hold-ink not-forced-colors:data-pointer-focus:outline-none forced-colors:text-[ButtonText] forced-colors:outline-1 forced-colors:outline-offset-0 forced-colors:outline-[ButtonText] forced-colors:before:bg-[ButtonFace] forced-colors:focus-visible:outline-2 forced-colors:focus-visible:outline-offset-4 forced-colors:focus-visible:outline-[Highlight]"
  >
    <span
      aria-hidden="true"
      class="inline-grid opacity-[calc(1-var(--hold-confirmed))] transition-opacity duration-(--hold-state) ease-hold *:col-start-1 *:row-start-1"
    >
      <span
        class="group-data-[state=holding]/hold:invisible group-data-[state=confirmed]/hold:invisible"
        >Hold to confirm</span
      >
      <span
        class="invisible group-data-[state=holding]/hold:visible group-data-[state=confirmed]/hold:visible"
        >Keep holding…</span
      >
    </span>
    <span
      data-hold-progress
      aria-hidden="true"
      class="absolute inset-0 flex items-center justify-center rounded-[inherit] text-hold-paper pointer-events-none [clip-path:inset(0_100%_0_0)] transition-[clip-path] duration-(--hold-release) ease-hold group-data-[state=confirmed]/hold:[clip-path:inset(0)] group-data-[state=holding]/hold:[clip-path:inset(0)] group-data-[state=holding]/hold:duration-(--hold-duration) group-data-[state=holding]/hold:ease-linear before:absolute before:inset-0 before:-z-1 before:rounded-[inherit] before:bg-hold-ink before:transition-transform before:duration-140 before:ease-hold motion-safe:group-data-pressed/hold:before:transform-[scale(0.98)] forced-colors:text-[HighlightText] forced-colors:forced-color-adjust-none forced-colors:before:bg-[Highlight] forced-colors:before:forced-color-adjust-none"
    >
      <span
        class="inline-grid opacity-[calc(1-var(--hold-confirmed))] transition-opacity duration-(--hold-state) ease-hold *:col-start-1 *:row-start-1"
      >
        <span
          class="group-data-[state=holding]/hold:invisible group-data-[state=confirmed]/hold:invisible"
          >Hold to confirm</span
        >
        <span
          class="invisible group-data-[state=holding]/hold:visible group-data-[state=confirmed]/hold:visible"
          >Keep holding…</span
        >
      </span>
    </span>
    <span
      aria-hidden="true"
      class="absolute inset-0 flex items-center justify-center gap-2 rounded-[inherit] text-hold-paper pointer-events-none opacity-(--hold-confirmed) transform-[translateY(calc((1-var(--hold-confirmed))*-3px))] transition-[opacity,transform] duration-(--hold-state) ease-hold forced-colors:text-[HighlightText] forced-colors:forced-color-adjust-none"
    >
      <svg
        viewBox="0 0 20 20"
        class="size-4.5 fill-none stroke-current stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round]"
      >
        <path d="m4.5 10 3.5 3.5 7.5-7.5"></path>
      </svg>
      Confirmed
    </span>
  </button>
  <span class="sr-only" data-hold-instructions></span>
  <span class="sr-only" role="status"></span>
  <dialog
    aria-label="Confirm this action"
    class="m-auto w-[min(320px,calc(100vw-32px))] rounded-2xl border border-transparent bg-hold-ink p-5 text-hold-paper font-sans backdrop:bg-hold-ink/24"
  >
    <form method="dialog">
      <p class="mb-5 text-sm/normal">Confirm this action?</p>
      <div
        class="flex justify-end gap-2 *:min-h-11 *:rounded-full *:border *:border-transparent *:px-4.5 *:text-sm *:font-medium *:cursor-pointer *:focus-visible:outline-2 *:focus-visible:outline-offset-2 *:focus-visible:outline-hold-paper"
      >
        <button value="cancel" class="pointer-fine:hover:bg-hold-paper/12"
          >Cancel</button
        >
        <button value="confirm" class="bg-hold-paper text-hold-ink"
          >Confirm</button
        >
      </div>
    </form>
  </dialog>
</hold-to-confirm>

<style is:global>
  @theme {
    --color-hold: oklch(0.925 0.004 258.74);
    --color-hold-hover: oklch(0.902 0.004 258.74);
    --color-hold-ink: oklch(0.23 0.012 258.74);
    --color-hold-paper: oklch(0.995 0.002 258.74);
    --ease-hold: cubic-bezier(0.23, 1, 0.32, 1);
  }
</style>
