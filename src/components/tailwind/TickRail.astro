<tick-rail class="group/tkr relative isolate grid w-[min(100%,480px)] grid-cols-[var(--tkr-rail)_minmax(0,1fr)] overflow-hidden rounded-[14px] border border-tkr-line bg-tkr-paper [--tkr-current:0.6667] [--tkr-rail:48px] [--tkr-rest:0.3333] [--tkr-size:24px] pointer-coarse:[--tkr-size:32px]">
  <nav class="grid auto-rows-(--tkr-size) content-center py-4" aria-label="On this page" data-rail>
    <a class="group/tick flex items-center pl-3 text-tkr-quiet [-webkit-tap-highlight-color:transparent] not-data-lit:aria-[current=location]:text-tkr-current focus-visible:rounded focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--focus-ring,var(--color-tkr)) data-lit:text-tkr" href="#tkr-overview" aria-describedby="tkr-overview-note" aria-current="location" data-tick>
