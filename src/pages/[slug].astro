---
import type { GetStaticPaths } from 'astro';
import videos from 'virtual:og-videos';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MorphArrow from '../components/MorphArrow.astro';
import SpecimenCode from '../components/SpecimenCode.astro';
import SpecimenStage from '../components/SpecimenStage.astro';
import StudyFigure from '../components/StudyFigure.astro';
import StudyHeading from '../components/StudyHeading.astro';
import { previews } from '../data/previews';
import { categorySlug, specimens, type Specimen } from '../data/specimens';
import BaseLayout from '../layouts/BaseLayout.astro';
import { socialImageAlt } from '../lib/social-image';

export const prerender = true;

export const getStaticPaths = (async () => {
  const studies = await getCollection('studies');
  return specimens.map((specimen, index) => {
    const study = studies.find((entry) => entry.id === specimen.id);
    if (!study) throw new Error(`Missing study article: src/content/studies/${specimen.id}.mdx`);

    return {
      params: { slug: specimen.id },
      props: { specimen, study, previous: specimens[index - 1], next: specimens[index + 1] },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  specimen: Specimen;
  study: CollectionEntry<'studies'>;
  previous?: Specimen;
  next?: Specimen;
}

const { specimen, study, previous, next } = Astro.props;
const { component: Preview, inspection, activeAttribute } = previews[specimen.id];
const { Content } = await render(study);
const { observe, references } = study.data;
// Recorded by pnpm run og:videos. A study without a clip keeps only its cover.
const video = videos.includes(specimen.id) ? `/og/videos/${specimen.id}.mp4` : undefined;
---

<BaseLayout title={`${specimen.seoTitle} — Microinteractions`} description={specimen.seoDescription} active={specimen.id} articleTitle={specimen.title} published={specimen.published} image={`/social/${specimen.id}.png`} imageAlt={socialImageAlt(specimen)} video={video}>
  <article>
    <header class="study-header">
      <div class="breadcrumb">
        <a href="/">Index</a>
        <span aria-hidden="true">/</span>
        <a href={`/#category-${categorySlug(specimen.category)}`}>{specimen.category}</a>
      </div>
      <h1>{specimen.title}</h1>
      <p class="summary">{specimen.summary}</p>
    </header>

    <section id="demo" class="demo" tabindex="-1" aria-labelledby="demo-heading">
      <div class="demo-toolbar">
        <h2 id="demo-heading">Live preview</h2>
        <a class="code-link" href="#implementation">Prompt and code</a>
      </div>
      <SpecimenStage specimen={specimen} inspection={inspection} activeAttribute={activeAttribute}>
        <Preview />
        {observe && <p slot="observation" class="observation">{observe}</p>}
      </SpecimenStage>
    </section>

    <div class="study-body">
      <Content specimenId={specimen.id} components={{ h2: StudyHeading, Implementation: SpecimenCode, Figure: StudyFigure }} />
    </div>

    {references.length > 0 && <section class="references" aria-labelledby="references">
      <StudyHeading id="references">References</StudyHeading>
      <ul>
        {references.map((reference) => <li>
          <a href={reference.url} target="_blank" rel="noopener noreferrer"><span class="reference-title">{reference.title}</span> <span class="reference-arrow" aria-hidden="true">↗</span></a>
          {reference.author && <span class="reference-author">{reference.author}</span>}
        </li>)}
      </ul>
    </section>}

    <nav class="study-pagination" aria-label="Continue exploring">
      <a href={previous ? `/${previous.id}/` : '/'}>
        <span class="direction">{previous ? 'Previous study' : 'Collection'}</span>
        <span class="pagination-title"><MorphArrow direction="left" /><span class="title-text">{previous?.title ?? 'Back to index'}</span></span>
      </a>
      <a class="next-study" href={next ? `/${next.id}/` : '/'}>
        <span class="direction">{next ? 'Next study' : 'Collection'}</span>
        <span class="pagination-title"><span class="title-text">{next?.title ?? 'Back to index'}</span><MorphArrow /></span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .study-header {
    margin-bottom: 24px;
  }

  .observation { margin: 20px 0 0; max-width: 65ch; color: var(--muted); font-size: 13px; line-height: 1.7; text-wrap: pretty; }

  .demo { scroll-margin-top: 24px; }
  .demo-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 8px; font: 11px/1.5 var(--font-mono); }
  .demo-toolbar h2 { margin: 0; color: var(--meta); font: inherit; }
  .code-link { display: inline-flex; min-height: 44px; align-items: center; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }

  .breadcrumb {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    margin: -12px 0 20px;
    color: var(--meta);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .breadcrumb a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.2;
    text-wrap: balance;
  }

  .summary {
    max-width: 60ch;
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .study-body { margin-top: 48px; }
  .study-body > :global(*) { margin: 0; }
  .study-body > :global(* + *) { margin-top: 16px; }
  .study-body > :global(h2:not(:first-child)),
  .study-body > :global(h3:not(:first-child)),
  .study-body > :global(.source),
  .study-body > :global(figure),
  .study-body > :global(pre) { margin-top: 36px; }

  .study-body > :global(p),
  .study-body > :global(ul),
  .study-body > :global(ol),
  .study-body > :global(blockquote) {
    max-width: 65ch;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .study-body > :global(ul),
  .study-body > :global(ol) { padding-left: 1.5em; }
  .study-body > :global(ul li + li),
  .study-body > :global(ol li + li) { margin-top: 8px; }
  .study-body > :global(blockquote) { padding: 16px 20px; border: 1px solid var(--line); border-radius: 12px; }
  .study-body > :global(blockquote p) { margin: 0; }
  .study-body > :global(h3) { max-width: 65ch; scroll-margin-top: 32px; font-size: 14px; font-weight: 500; }
  .study-body > :global(p code),
  .study-body > :global(ul code),
  .study-body > :global(ol code),
  .study-body > :global(blockquote code) {
    color: var(--text);
    background: var(--surface);
    padding: 0.12em 0.25em;
    border-radius: 4px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    font-family: var(--font-mono);
    font-size: 1em;
    line-height: inherit;
    overflow-wrap: anywhere;
  }
  .study-body > :global(p a),
  .study-body > :global(ul a),
  .study-body > :global(ol a),
  .study-body > :global(blockquote a) {
    color: var(--brand);
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }
  .study-body > :global(p a:focus-visible),
  .study-body > :global(ul a:focus-visible),
  .study-body > :global(ol a:focus-visible),
  .study-body > :global(blockquote a:focus-visible) { color: var(--text); }
  @media (hover: hover) and (pointer: fine) {
    .study-body > :global(p a:hover),
    .study-body > :global(ul a:hover),
    .study-body > :global(ol a:hover),
    .study-body > :global(blockquote a:hover) { color: var(--text); }
  }
  .study-body > :global(pre) { overflow: auto; padding: 24px; border: 1px solid var(--line-strong); border-radius: 12px; font: 12px/1.8 var(--font-mono); tab-size: 2; }
  .study-body > :global(pre code) { font: inherit; }
  .study-body > :global(p img) { display: block; max-width: 100%; height: auto; border-radius: 12px; }
  .study-body :global(a:focus-visible),
  .demo:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; border-radius: 2px; }

  .references { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line); }
  .references ul { margin: 16px 0 0; padding: 0; list-style: none; }
  .references li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 16px; font-size: 13px; }
  .references a { display: inline-flex; min-height: 44px; align-items: center; gap: 6px; text-decoration: none; }
  .references a .reference-title { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }
  .references a .reference-arrow { text-decoration: none; }
  .reference-author { color: var(--muted); font-size: 12px; }

  .study-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 80px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .study-pagination a {
    display: flex;
    min-height: 60px;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  .next-study {
    align-items: flex-end;
    text-align: right;
  }

  .direction {
    color: var(--meta);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .pagination-title {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 12px;
    line-height: 1.5;
  }

  .title-text {
    text-wrap: balance;
  }

  a {
    touch-action: manipulation;
  }

  a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .code-link:hover,
    .references a:hover .reference-title { text-decoration-color: var(--text); }

    .breadcrumb a:hover,
    .study-pagination a:hover .title-text {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  @media (max-width: 480px) {
    .breadcrumb {
      margin-bottom: 16px;
      font-size: 10px;
    }

    h1 {
      font-size: 24px;
    }

    .summary {
      font-size: 13px;
    }

    .study-body { margin-top: 36px; }
    .study-body > :global(pre) { padding: 16px; }

    .study-pagination {
      gap: 20px;
      margin-top: 56px;
    }
  }
</style>
