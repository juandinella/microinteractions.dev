---
import CategoryIcon from '../components/CategoryIcon.astro';
import SpecimenRow from '../components/SpecimenRow.astro';
import { author } from '../data/author';
import { repository } from '../data/repository';
import { categories, categorySlug, specimens } from '../data/specimens';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const groups = categories
  .map((category) => ({ category, studies: specimens.filter((s) => s.category === category) }))
  .filter((group) => group.studies.length > 0);
---

<BaseLayout>
  <header class="intro">
    <h1>Microinteractions</h1>
    <p class="description">A collection of small UI experiments. I built these to explore how timing changes the way an interaction feels. Each experiment includes notes and source code. The site is open source <a href={repository.url} target="_blank" rel="noopener noreferrer">on GitHub</a>.</p>
    <p class="byline">
      A project by <a href={author.url} target="_blank" rel="noopener noreferrer" aria-label={`${author.name} — juandinella.com`}>
        <span class="author-name" aria-hidden="true">{author.name}</span>
        <span class="author-domain" aria-hidden="true">juandinella.com</span>
      </a>
    </p>
  </header>

  <div class="collection">
    {groups.map(({ category, studies }) => (
      <section id={`category-${categorySlug(category)}`} aria-labelledby={`heading-${categorySlug(category)}`}>
        <h2 id={`heading-${categorySlug(category)}`}>
          <CategoryIcon category={category} />
          {category}
        </h2>
        <ol>
          {studies.map((s) => (
            <li>
              <SpecimenRow specimen={s} />
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .intro {
    max-width: 640px;
    margin-bottom: 56px;
  }

  h1 {
    margin: 0;
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.2;
    text-wrap: balance;
  }

  .description {
    max-width: 58ch;
    margin: 16px 0 10px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .description a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .description a:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .description a:hover {
      text-decoration-color: currentColor;
    }
  }

  .byline {
    margin: 0;
    color: var(--meta);
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .byline a {
    display: inline-grid;
    min-height: 44px;
    align-items: center;
    vertical-align: middle;
    color: var(--text);
  }

  .byline a span {
    grid-area: 1 / 1;
    width: fit-content;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
    transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1), opacity 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .author-domain {
    position: relative;
    top: -0.5px;
    opacity: 0;
    transform: translateY(4px);
  }

  .byline a:focus-visible .author-name {
    opacity: 0;
  }

  .byline a:focus-visible .author-domain {
    opacity: 1;
    transform: none;
  }

  .byline a:focus-visible span {
    transition: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .byline a:hover .author-name {
      opacity: 0;
      transform: translateY(-4px);
    }

    .byline a:hover .author-domain {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .byline a span,
    .byline a:is(:hover, :focus-visible) span {
      transition: none;
      transform: none;
    }
  }

  section {
    scroll-margin-top: 24px;
  }

  /* Sections outrank rows: a wider gap plus the heading's rule, while rows get space alone. */
  section + section {
    margin-top: 80px;
  }

  .collection h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    color: var(--meta);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  ol > li {
    min-width: 0;
  }

  .byline a:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }
</style>
