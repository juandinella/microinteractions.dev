{
	"compatibility_date": "2026-06-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "microinteractions",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "force-trailing-slash",
		"run_worker_first": ["/*", "!/_astro/*", "!/markdown/*"]
	},
	"observability": {
		"enabled": true
	}
}
