{
	"compatibility_date": "2026-06-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "microinteractions",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "force-trailing-slash",
		// Files that need nothing from the Worker skip it; their headers come from _headers.
		"run_worker_first": ["/*", "!/_astro/*", "!/markdown/*", "!/fonts/*", "!/social/*", "!/og/*", "!/favicon.svg"]
	},
	"observability": {
		"enabled": true
	}
}
